---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../islands/SiteHeader';
import SiteFooter from '../../components/SiteFooter.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import ToolCTA from '../../components/ToolCTA.astro';
import DataSources from '../../components/DataSources.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import { getNamesByLetter } from '../../lib/names/getAllNames';
import { ALPHABET, formatNumber } from '../../data/nameData';
import { getNameUrl, getLetterUrl } from '../../lib/seo/canonicalUrl';

export async function getStaticPaths() {
  return ALPHABET.map((letter) => ({
    params: { letter },
    props: { letter },
  }));
}

interface Props {
  letter?: string;
}

const { letter: rawLetter } = Astro.params;
const l = (rawLetter || 'a').toLowerCase();
const L = l.toUpperCase();

const nameRecords = getNamesByLetter(l);
const idx = ALPHABET.indexOf(l);
const prev = ALPHABET[(idx - 1 + 26) % 26];
const next = ALPHABET[(idx + 1) % 26];

const title = `Names Starting with ${L} — Popularity & Meanings (A–Z Directory)`;
const description = `Browse ${nameRecords.length.toLocaleString()} first names beginning with ${L}. Click any name to see how many people have it worldwide, decade-by-decade popularity, and regional data. Free, no signup.`;
const canonical = `https://howmanyofme.co/names/${l}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `Names Starting with ${L}`,
    description: `A–Z name directory of popular first names starting with the letter ${L}.`,
    numberOfItems: nameRecords.length,
    itemListElement: nameRecords.map((item, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: item.name,
      url: `https://howmanyofme.co${getNameUrl(item.name)}`,
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
>
  <SiteHeader client:idle />

  <main class="container py-12">
    <Breadcrumbs
      className="mb-6"
      items={[
        { label: "Home", href: "/" },
        { label: "Browse Names A–Z", href: "/names/a" },
        { label: `Names starting with ${L}` },
      ]}
    />

    <!-- A–Z Quick Jump Bar -->
    <nav aria-label="Alphabet letter selection" class="flex flex-wrap gap-1.5 mb-8">
      {ALPHABET.map((a) => (
        <a
          href={getLetterUrl(a)}
          class={`w-9 h-9 flex items-center justify-center rounded-md text-sm font-bold uppercase transition-colors ${
            a === l
              ? 'bg-primary text-primary-foreground font-extrabold shadow-sm'
              : 'bg-secondary text-muted-foreground hover:bg-primary/10 hover:text-primary'
          }`}
          aria-current={a === l ? 'page' : undefined}
        >
          {a}
        </a>
      ))}
    </nav>

    <div class="mb-8">
      <h1 class="font-display text-4xl md:text-5xl font-bold mb-3 text-foreground">
        Names Starting with "{L}"
      </h1>
      <p class="text-muted-foreground text-lg max-w-3xl">
        Browse <strong class="text-foreground">{nameRecords.length.toLocaleString()}</strong> names beginning with the letter {L}. Click any name to explore detailed bearer statistics, global ranking, and decade popularity curves.
      </p>
    </div>

    <AdSlot />

    <!-- Name Grid (100% Server Rendered HTML Links) -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 my-8">
      {nameRecords.map((item) => (
        <a
          href={getNameUrl(item.name)}
          class="p-4 rounded-xl border border-border bg-card hover:border-primary/40 hover:shadow-md transition-all group flex flex-col justify-between"
        >
          <div class="flex items-center justify-between mb-1.5">
            <span class="font-semibold text-foreground group-hover:text-primary transition-colors">
              {item.name}
            </span>
            <span class="text-[10px] uppercase font-bold px-1.5 py-0.5 rounded bg-secondary text-muted-foreground">
              {item.gender}
            </span>
          </div>
          <div class="text-xs text-muted-foreground">
            ~{formatNumber(item.count)} people
          </div>
        </a>
      ))}
    </div>

    {nameRecords.length === 0 && (
      <p class="text-muted-foreground text-center py-20">
        No names found for this letter yet. Our database is continuously expanding.
      </p>
    )}

    <div class="my-8">
      <AdSlot />
    </div>

    <!-- Editorial content about names starting with letter -->
    <div class="prose-content mt-12">
      <h2>About Names Starting with {L}</h2>
      <p>
        The letter {L} contains {nameRecords.length > 20 ? 'a rich variety' : 'a curated selection'} of names spanning multiple cultures, languages, and historical periods. Names beginning with {L} include both timeless classics that have been popular for centuries and modern innovations that reflect contemporary naming trends.
      </p>
      <p>
        Each name links to a comprehensive statistics page where you can discover how many people share that name in the United States, its historical popularity trends from 1880 through 2024, gender distribution, census rankings, and lists of similar names to explore.
      </p>
    </div>

    <!-- Tool CTA -->
    <ToolCTA
      headline={`Check any ${L}-name's popularity instantly`}
      subhead={`Type a name starting with ${L} and see living bearer estimates and popularity trends.`}
    />

    <!-- Prev/Next Letter Navigation -->
    <div class="mt-10 grid grid-cols-2 gap-4">
      <a
        href={getLetterUrl(prev)}
        class="p-4 rounded-xl border border-border bg-card hover:bg-secondary/50 hover:border-primary/30 transition-colors group"
      >
        <div class="text-xs text-muted-foreground mb-1 group-hover:text-primary transition-colors">← Previous letter</div>
        <div class="font-semibold text-foreground">Names starting with {prev.toUpperCase()}</div>
      </a>
      <a
        href={getLetterUrl(next)}
        class="p-4 rounded-xl border border-border bg-card hover:bg-secondary/50 hover:border-primary/30 transition-colors text-right group"
      >
        <div class="text-xs text-muted-foreground mb-1 group-hover:text-primary transition-colors">Next letter →</div>
        <div class="font-semibold text-foreground">Names starting with {next.toUpperCase()}</div>
      </a>
    </div>

    <!-- Trust block -->
    <DataSources
      className="mt-8 max-w-3xl"
      context={`Directory data for names starting with ${L} is compiled from U.S. Social Security Administration records, national census data, and demographic modeling.`}
    />

    <RelatedPosts currentSlug={`names-${l}`} tags={['baby names', 'popularity', 'directory', 'name meanings']} count={6} />
  </main>

  <SiteFooter />
</BaseLayout>
