---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../islands/SiteHeader';
import SiteFooter from '../../components/SiteFooter.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import ToolCTA from '../../components/ToolCTA.astro';
import BookmarkShareButtons from '../../islands/BookmarkShareButtons';
import NameHistoryChart from '../../islands/NameHistoryChart';
import { getIndexableNames, getName, type NameRecord } from '../../lib/names';
import { buildNamePageViewModel } from '../../lib/names/insights';
import { getNameLinkGraph } from '../../lib/names/linking';
import { getRelatedFullNames } from '../../lib/fullNames/data';
import { getComparisonsForName } from '../../lib/comparisons/data';
import { getNameAbsoluteUrl, getSimilarNamesUrl } from '../../lib/seo/canonicalUrl';
import { evaluateNameIndexability } from '../../lib/seo/indexability';
import { formatNumber } from '../../data/nameData';
import { buildNameSeoMetadata } from '../../lib/seo/performanceData.ts';
import manifest from '../../data/metadata/manifest.json';
import {
  Sparkles,
  TrendingUp,
  MapPin,
  Users,
  Calendar,
  Award,
  BookOpen,
  Info,
  ArrowRight,
  ExternalLink,
} from 'lucide-react';

export async function getStaticPaths() {
  const allNames = getIndexableNames();

  return allNames.map((record) => ({
    params: { name: record.slug },
    props: { record },
  }));
}

interface Props {
  record?: NameRecord;
}

const { name: rawName } = Astro.params;
const { record: propsRecord } = Astro.props;

const data = propsRecord || getName(rawName || '', false);

if (!data) {
  return Astro.redirect('/404');
}

const indexability = evaluateNameIndexability(data);
if (indexability.status === 'EXCLUDE') {
  return Astro.redirect('/404');
}

const vm = buildNamePageViewModel(data);
const seoMeta = buildNameSeoMetadata(data, vm.livingEstimate, vm.rank);
const linkGraph = getNameLinkGraph(data);
const popularFullNames = getRelatedFullNames(vm.name, '', 16);
const nameComparisons = getComparisonsForName(vm.name);

const title = seoMeta.title;
const description = seoMeta.description;
const canonical = getNameAbsoluteUrl(vm.name);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description: description,
    url: canonical,
    about: {
      '@type': 'Thing',
      name: vm.name,
      description: `Official demographic statistics, national rank #${formatNumber(vm.rank)}, and historical frequency for the first name ${vm.name}.`,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: vm.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

const firstLetter = vm.name.charAt(0).toUpperCase();
const decades = Object.entries(data.decade_popularity || {});
const historyPoints = data.ssa?.history || [];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  noindex={indexability.status !== 'INDEX'}
  jsonLd={jsonLd}
>
  <SiteHeader client:idle />

  <main class="container py-10 md:py-12 max-w-5xl">
    <Breadcrumbs
      className="mb-6"
      items={[
        { label: "Home", href: "/" },
        { label: `Names: ${firstLetter}`, href: linkGraph.letterHub.url },
        { label: vm.name },
      ]}
    />

    <!-- Header & Share Action Row -->
    <div class="flex flex-wrap items-start justify-between gap-4 mb-8">
      <div>
        <h1 class="font-display text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold mb-3 text-foreground tracking-tight">
          {seoMeta.h1}
        </h1>
        <p class="text-lg md:text-xl text-muted-foreground">
          {seoMeta.subhead}
        </p>
      </div>
      <BookmarkShareButtons client:idle name={vm.name} />
    </div>

    <!-- 1. Answer-First Quick Answer Card (Featured Snippet / AEO Target) -->
    <section aria-label="Quick Answer" class="mb-10 p-6 md:p-8 rounded-2xl border-2 border-primary/25 bg-gradient-to-br from-primary/5 via-card to-secondary/30 shadow-sm">
      <div class="flex items-center gap-2 mb-3">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider bg-primary text-primary-foreground">
          ⚡ Quick Answer
        </span>
        <span class="text-xs text-muted-foreground">
          SSA 1880–{manifest.sources.ssa.latestAvailableYear} · Census {manifest.sources.census.coverageYear}
        </span>
      </div>

      <p class="text-lg md:text-xl font-medium leading-relaxed text-foreground mb-6">
        {vm.quickAnswer}
      </p>

      <!-- Structured Demographic Summary Table for AEO / Snippets -->
      <div class="overflow-x-auto my-6 border border-border/80 rounded-xl bg-card/60 p-4">
        <table class="w-full text-left text-sm border-collapse">
          <thead>
            <tr class="border-b border-border text-xs font-semibold text-muted-foreground uppercase tracking-wider">
              <th class="py-2 pr-4">Demographic Metric</th>
              <th class="py-2 px-4">Calculated Value</th>
              <th class="py-2 pl-4">Source & Methodology</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border/50 text-foreground">
            <tr>
              <td class="py-2.5 pr-4 font-medium">Estimated Living U.S. Bearers</td>
              <td class="py-2.5 px-4 font-bold text-primary">~{formatNumber(vm.livingEstimate)}</td>
              <td class="py-2.5 pl-4 text-xs text-muted-foreground">CDC Actuarial Life Table Model</td>
            </tr>
            <tr>
              <td class="py-2.5 pr-4 font-medium">All-Time SSA Births (1880–{manifest.sources.ssa.latestAvailableYear})</td>
              <td class="py-2.5 px-4 font-bold">{formatNumber(vm.historicalBirths)}</td>
              <td class="py-2.5 pl-4 text-xs text-muted-foreground">Social Security Administration</td>
            </tr>
            <tr>
              <td class="py-2.5 pr-4 font-medium">National Popularity Standing</td>
              <td class="py-2.5 px-4 font-bold">#{formatNumber(vm.rank)}</td>
              <td class="py-2.5 pl-4 text-xs text-muted-foreground">U.S. First-Name Historical Index</td>
            </tr>
            <tr>
              <td class="py-2.5 pr-4 font-medium">Peak Registration Year</td>
              <td class="py-2.5 px-4 font-bold">{vm.peakYear} ({formatNumber(vm.peakBirths)} births)</td>
              <td class="py-2.5 pl-4 text-xs text-muted-foreground">SSA Historical Records</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Key metric pills -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-border">
        <div class="p-3.5 rounded-xl bg-card border border-border">
          <div class="text-xs text-muted-foreground mb-1">Estimated Living (U.S.)</div>
          <div class="text-xl font-bold text-foreground">~{formatNumber(vm.livingEstimate)}</div>
        </div>
        <div class="p-3.5 rounded-xl bg-card border border-border">
          <div class="text-xs text-muted-foreground mb-1">Historical Births (SSA)</div>
          <div class="text-xl font-bold text-foreground">{formatNumber(vm.historicalBirths)}</div>
        </div>
        <div class="p-3.5 rounded-xl bg-card border border-border">
          <div class="text-xs text-muted-foreground mb-1">All-Time Rank</div>
          <div class="text-xl font-bold text-foreground">#{formatNumber(vm.rank)}</div>
        </div>
        <div class="p-3.5 rounded-xl bg-card border border-border">
          <div class="text-xs text-muted-foreground mb-1">Historical Peak</div>
          <div class="text-xl font-bold text-foreground">{vm.peakYear}</div>
        </div>
      </div>
    </section>

    <!-- 2. Target-Specific Key Insights (Structured Bullet Points) -->
    <section class="mb-12 p-6 rounded-2xl border border-border bg-card shadow-xs">
      <div class="flex items-center gap-2 mb-4">
        <Sparkles class="h-4 w-4 text-primary" />
        <h2 class="font-display text-xl font-bold text-foreground">
          Key Insights for {vm.name}
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {vm.keyInsights.map((insight) => (
          <div class="p-4 rounded-xl bg-secondary/30 border border-border/70">
            <div class="text-xs font-semibold text-muted-foreground mb-1">{insight.label}</div>
            <div class="text-lg font-bold text-foreground mb-0.5">{insight.value}</div>
            {insight.detail && <div class="text-xs text-muted-foreground">{insight.detail}</div>}
          </div>
        ))}
      </div>
    </section>

    <!-- 3. Key Demographic Statistics Grid -->
    <section class="mb-12">
      <h2 class="font-display text-2xl font-bold mb-4 text-foreground">
        Key Demographic Statistics for {vm.name}
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="p-5 rounded-xl border border-border bg-card">
          <div class="text-xs font-semibold text-primary uppercase tracking-wider mb-1">Living Population Model</div>
          <div class="text-2xl font-bold text-foreground mb-1">~{formatNumber(vm.livingEstimate)}</div>
          <p class="text-xs text-muted-foreground">Estimated living U.S. population based on actuarial cohort survival rates.</p>
        </div>

        <div class="p-5 rounded-xl border border-border bg-card">
          <div class="text-xs font-semibold text-primary uppercase tracking-wider mb-1">Total Recorded Births</div>
          <div class="text-2xl font-bold text-foreground mb-1">{formatNumber(vm.historicalBirths)}</div>
          <p class="text-xs text-muted-foreground">U.S. Social Security card registrations recorded from 1880 through 2024.</p>
        </div>

        <div class="p-5 rounded-xl border border-border bg-card">
          <div class="text-xs font-semibold text-primary uppercase tracking-wider mb-1">2020 Decennial Census</div>
          <div class="text-2xl font-bold text-foreground mb-1">
            {vm.censusCount ? formatNumber(vm.censusCount) : "Unlisted (<100)"}
          </div>
          <p class="text-xs text-muted-foreground">Official count in 2020 U.S. Census first-name frequency returns.</p>
        </div>

        <div class="p-5 rounded-xl border border-border bg-card">
          <div class="text-xs font-semibold text-primary uppercase tracking-wider mb-1">Estimated Average Age</div>
          <div class="text-2xl font-bold text-foreground mb-1">{vm.estimatedAverageAge} Years</div>
          <p class="text-xs text-muted-foreground">Weighted average age calculated from surviving historical birth cohorts.</p>
        </div>

        <div class="p-5 rounded-xl border border-border bg-card">
          <div class="text-xs font-semibold text-primary uppercase tracking-wider mb-1">Peak Historical Year</div>
          <div class="text-2xl font-bold text-foreground mb-1">{vm.peakYear}</div>
          <p class="text-xs text-muted-foreground">Highest annual total: {formatNumber(vm.peakBirths)} registrations in {vm.peakYear}.</p>
        </div>

        <div class="p-5 rounded-xl border border-border bg-card">
          <div class="text-xs font-semibold text-primary uppercase tracking-wider mb-1">Recent 10-Year Trend</div>
          <div class="text-2xl font-bold text-foreground mb-1 capitalize">
            {vm.recentTrendDirection} ({vm.recentTrendPct >= 0 ? `+${vm.recentTrendPct}%` : `${vm.recentTrendPct}%`})
          </div>
          <p class="text-xs text-muted-foreground">Registration change over the recent 2015–2024 window.</p>
        </div>
      </div>
    </section>

    <!-- 4. Annual Popularity History & Interactive Chart -->
    <section class="mb-12">
      <h2 class="font-display text-2xl font-bold mb-2 text-foreground">
        Historical Popularity &amp; Annual Trends
      </h2>
      <p class="text-sm text-muted-foreground mb-6">
        {vm.trendSummary}
      </p>

      {vm.hasHistory && (
        <div class="mb-6">
          <NameHistoryChart
            client:visible
            name={vm.name}
            history={historyPoints}
            peakYear={vm.peakYear}
            peakBirths={vm.peakBirths}
          />
        </div>
      )}

      <!-- Accessible Semantic History Summary (Pure SSR / No-JS fallback) -->
      {historyPoints.length > 0 && (
        <details class="p-4 rounded-xl border border-border bg-card/60 text-sm mb-6">
          <summary class="font-semibold text-foreground cursor-pointer hover:text-primary transition">
            📊 View Selected Historical Timeline Data Table (1880–2024)
          </summary>
          <div class="mt-4 overflow-x-auto">
            <table class="w-full text-left text-xs border-collapse">
              <thead>
                <tr class="border-b border-border bg-secondary/50">
                  <th class="p-2 font-semibold">Year</th>
                  <th class="p-2 font-semibold">Total Births</th>
                  <th class="p-2 font-semibold">Male</th>
                  <th class="p-2 font-semibold">Female</th>
                </tr>
              </thead>
              <tbody>
                {historyPoints.slice(-15).map((pt) => (
                  <tr class="border-b border-border/50 hover:bg-secondary/30">
                    <td class="p-2 font-medium">{pt.year}</td>
                    <td class="p-2">{formatNumber(pt.births)}</td>
                    <td class="p-2 text-blue-600 dark:text-blue-400">{formatNumber(pt.male)}</td>
                    <td class="p-2 text-pink-600 dark:text-pink-400">{formatNumber(pt.female)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="text-xs text-muted-foreground mt-2">Showing 15 most recent milestone years. Source: SSA 1880–2024.</p>
          </div>
        </details>
      )}

      <!-- Decade Popularity Index Grid -->
      {decades.length > 0 && (
        <div>
          <h3 class="font-display text-lg font-bold mb-3 text-foreground">Relative Popularity by Decade</h3>
          <div class="grid grid-cols-3 sm:grid-cols-5 md:grid-cols-9 gap-2.5">
            {decades.map(([decade, score]) => (
              <div class="text-center p-3 rounded-lg bg-secondary/70 border border-border/60">
                <div class="text-xs text-muted-foreground mb-1 font-medium">{decade}</div>
                <div class="h-2 rounded-full bg-border overflow-hidden">
                  <div class="h-full rounded-full bg-primary" style={{ width: `${score}%` }} />
                </div>
                <div class="text-xs font-bold mt-1.5 text-foreground">{score}/100</div>
              </div>
            ))}
          </div>
        </div>
      )}
    </section>

    <!-- 5. Sex & Gender Distribution Breakdown -->
    <section class="mb-12 p-6 rounded-2xl border border-border bg-card">
      <h2 class="font-display text-2xl font-bold mb-2 text-foreground">
        Sex &amp; Gender Distribution in Historical Records
      </h2>
      <p class="text-sm text-muted-foreground mb-6">
        {vm.genderSummary}
      </p>

      <div class="space-y-4 max-w-xl">
        <div class="flex justify-between text-sm font-semibold">
          <span class="text-blue-600 dark:text-blue-400">Male: {vm.maleShare}% (~{formatNumber(data.ssa?.maleBirths || 0)} births)</span>
          <span class="text-pink-600 dark:text-pink-400">Female: {vm.femaleShare}% (~{formatNumber(data.ssa?.femaleBirths || 0)} births)</span>
        </div>
        <div class="h-4 rounded-full bg-secondary overflow-hidden flex">
          <div class="bg-blue-500 h-full transition-all" style={{ width: `${vm.maleShare}%` }} />
          <div class="bg-pink-500 h-full transition-all" style={{ width: `${vm.femaleShare}%` }} />
        </div>
        <p class="text-xs text-muted-foreground">
          Distribution calculated from cumulative U.S. Social Security application records (1880–2024).
        </p>
      </div>
    </section>

    <!-- 6. Origin & Meaning Section -->
    <section class="mb-12 p-6 rounded-2xl border border-border bg-card">
      <div class="flex items-center gap-2 mb-3">
        <BookOpen class="h-5 w-5 text-primary" />
        <h2 class="font-display text-2xl font-bold text-foreground">
          Origin &amp; Meaning of the Name {vm.name}
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="p-4 rounded-xl bg-secondary/30 border border-border/70">
          <div class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-1">Cultural / Linguistic Origin</div>
          <div class="text-lg font-bold text-foreground">{vm.origin}</div>
          <p class="text-xs text-muted-foreground mt-1">Linguistic root and etymological background.</p>
        </div>
        <div class="p-4 rounded-xl bg-secondary/30 border border-border/70">
          <div class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-1">Traditional Meaning</div>
          <div class="text-lg font-bold text-foreground">"{vm.meaning}"</div>
          <p class="text-xs text-muted-foreground mt-1">Historical interpretation recorded in onomastic sources.</p>
        </div>
      </div>
    </section>

    <!-- 7. Census 2020 Snapshot Section -->
    <section class="mb-12 p-6 rounded-2xl border border-border bg-card">
      <div class="flex items-center gap-2 mb-2">
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-secondary text-foreground">
          🏛️ Official Census
        </span>
        <h2 class="font-display text-2xl font-bold text-foreground">
          {vm.name} in the 2020 Decennial Census
        </h2>
      </div>

      {vm.hasCensus ? (
        <div class="space-y-4">
          <p class="text-sm text-muted-foreground">
            In the 2020 Decennial U.S. Census first-name tabulations, <strong>{vm.name}</strong> appeared {formatNumber(vm.censusCount!)} times, ranking #{formatNumber(vm.censusRank!)} among all first names recorded in 2020 returns.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="p-4 rounded-xl bg-secondary/50 border border-border/80">
              <div class="text-xs text-muted-foreground mb-1">Census 2020 Count</div>
              <div class="text-xl font-bold text-foreground">{formatNumber(vm.censusCount!)} Bearers</div>
            </div>
            <div class="p-4 rounded-xl bg-secondary/50 border border-border/80">
              <div class="text-xs text-muted-foreground mb-1">Census 2020 Rank</div>
              <div class="text-xl font-bold text-foreground">#{formatNumber(vm.censusRank!)}</div>
            </div>
            <div class="p-4 rounded-xl bg-secondary/50 border border-border/80">
              <div class="text-xs text-muted-foreground mb-1">Census Sex Breakdown</div>
              <div class="text-sm font-semibold text-foreground">
                {data.census2020?.pctMale ?? 0}% M · {data.census2020?.pctFemale ?? 0}% F
              </div>
            </div>
          </div>
        </div>
      ) : (
        <div class="p-4 rounded-xl bg-secondary/30 text-sm text-muted-foreground">
          ℹ️ The 2020 Decennial Census first-name release only tabulates names with 100 or more observations in returns.
        </div>
      )}
    </section>

    <!-- 8. Geographic State Distribution -->
    {vm.hasStateDistribution && (
      <section class="mb-12">
        <h2 class="font-display text-2xl font-bold mb-2 text-foreground">
          Where Is the Name {vm.name} Most Common?
        </h2>
        <p class="text-sm text-muted-foreground mb-4">
          {vm.geographicSummary} Estimated state-level distribution of living bearers:
        </p>

        <div class="overflow-x-auto rounded-xl border border-border bg-card">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="border-b border-border bg-secondary/50 text-xs font-semibold text-muted-foreground uppercase">
                <th class="p-3">State</th>
                <th class="p-3">Estimated Living Bearers</th>
                <th class="p-3">Share of U.S. Total</th>
              </tr>
            </thead>
            <tbody>
              {vm.stateDistribution.map((st) => (
                <tr class="border-b border-border/50 hover:bg-secondary/30">
                  <td class="p-3 font-medium text-foreground">{st.state} ({st.code})</td>
                  <td class="p-3">~{formatNumber(st.estimatedBearers)}</td>
                  <td class="p-3">{st.percentageOfTotal}%</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <div class="my-10">
      <AdSlot />
    </div>

    <!-- 9. Actuarial Living Estimate & Survival Model -->
    <section class="mb-12 p-6 rounded-2xl border border-border bg-card">
      <h2 class="font-display text-2xl font-bold mb-3 text-foreground">
        Actuarial Living Population &amp; Average Age Model
      </h2>
      <p class="text-sm leading-relaxed text-muted-foreground mb-4">
        Based on cohort survival models applied to 1880–2024 SSA birth registrations, an estimated <strong>{formatNumber(vm.livingEstimate)}</strong> people named {vm.name} are living today in the U.S., with an estimated average age of <strong>{vm.estimatedAverageAge} years</strong>.
      </p>
      <div class="p-4 rounded-xl bg-secondary/40 border border-border/60 text-xs text-muted-foreground space-y-2">
        <p>
          <strong>Methodology Note:</strong> Lifetime birth registrations do not equal the current living population. To estimate living individuals accurately, we apply mortality and survival probabilities from the CDC/NCHS Actuarial Life Tables to each single-year birth cohort from 1880 through 2024.
        </p>
        <p>
          Estimated Average Age for {vm.name}: <strong class="text-foreground">{vm.estimatedAverageAge} years</strong>.
        </p>
      </div>
    </section>

    <!-- 10. Transparent Methodology & Data Provenance Block -->
    <section class="mb-12 p-6 md:p-8 rounded-2xl border border-border bg-secondary/30">
      <h2 class="font-display text-2xl font-bold mb-4 text-foreground">
        Data Sources, Provenance &amp; Methodology
      </h2>
      <div class="space-y-4 text-sm text-muted-foreground leading-relaxed">
        <p>
          HowManyOfMe.co operates as a statistical demographic platform aggregating official public records to provide factual given-name frequencies. Our calculations distinguish between observed historical registrations, decennial census enumerations, and derived actuarial models:
        </p>
        <ul class="list-disc list-inside space-y-2 text-xs md:text-sm">
          <li><strong>U.S. Social Security Administration (SSA) Baby Names Dataset (1880–2024):</strong> All historical births with Social Security card applications (minimum 5 occurrences per year/sex).</li>
          <li><strong>U.S. Census Bureau 2020 Decennial Census:</strong> First-name frequency tabulations covering distinct names occurring 100+ times in 2020 census returns.</li>
          <li><strong>Actuarial Living Estimates:</strong> Calculated by multiplying birth cohorts from 1880 to 2024 by CDC/NCHS life table survival probabilities to estimate current living population rather than lifetime cumulative births.</li>
          <li><strong>State Distributions:</strong> Demographic frequency allocation proportional to state census population weights.</li>
        </ul>

        <div class="pt-4 border-t border-border flex flex-wrap gap-4 text-xs text-muted-foreground">
          <span><strong>SSA Dataset Coverage:</strong> 1880–{manifest.sources.ssa.latestAvailableYear}</span>
          <span><strong>Census Snapshot:</strong> {manifest.sources.census.coverageYear}</span>
          <span><strong>Dataset Version:</strong> {manifest.dataVersion}</span>
        </div>
      </div>
    </section>

    <!-- 11. Related Names by Origin -->
    {linkGraph.relatedByOrigin.length > 0 && (
      <section class="mb-12 p-6 rounded-xl border border-border bg-card">
        <h2 class="font-display text-xl font-bold mb-2 text-foreground">
          Names with Similar Origin ({vm.origin})
        </h2>
        <p class="text-xs text-muted-foreground mb-4">
          Discover other historical names sharing {vm.origin} linguistic roots:
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-2.5">
          {linkGraph.relatedByOrigin.map((rel) => (
            <a
              href={rel.url}
              class="p-3 rounded-lg border border-border bg-secondary/40 hover:bg-primary/10 hover:border-primary/30 transition text-center group"
            >
              <div class="font-semibold text-foreground group-hover:text-primary transition">{rel.name}</div>
              <div class="text-xs text-muted-foreground">{rel.origin}</div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- 12. Similar Sounding Names -->
    {linkGraph.similarNames.length > 0 && (
      <section class="mb-12 p-6 rounded-xl border border-border bg-card">
        <div class="flex items-center justify-between gap-4 mb-3">
          <h2 class="font-display text-xl font-bold text-foreground">
            Similar Sounding &amp; Variant Names
          </h2>
          <a
            href={getSimilarNamesUrl(vm.name)}
            class="text-xs font-semibold text-primary hover:underline"
          >
            Explore all variants &rarr;
          </a>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-2.5">
          {linkGraph.similarNames.map((sim) => (
            <a
              href={sim.url}
              class="p-3 rounded-lg border border-border bg-secondary/40 hover:bg-primary/10 hover:border-primary/30 transition text-center group"
            >
              <div class="font-semibold text-foreground group-hover:text-primary transition">{sim.name}</div>
              <div class="text-xs text-muted-foreground">View profile &rarr;</div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- 13. Head-to-Head Name Comparisons -->
    {nameComparisons.length > 0 && (
      <section class="mb-12 p-6 rounded-xl border border-border bg-card">
        <div class="flex items-center justify-between gap-4 mb-3">
          <h2 class="font-display text-xl font-bold text-foreground">
            Head-to-Head Comparisons for {vm.name}
          </h2>
          <a
            href="/tools/name-comparison"
            class="text-xs font-semibold text-primary hover:underline"
          >
            All comparisons &rarr;
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
          {nameComparisons.map((pair) => (
            <a
              href={`/name-comparison/${pair.slug}`}
              class="p-3.5 rounded-lg border border-border bg-secondary/40 hover:bg-primary/10 hover:border-primary/30 transition group text-center"
            >
              <div class="text-xs font-bold text-primary mb-1 uppercase tracking-wider">{pair.category}</div>
              <div class="font-bold text-foreground group-hover:text-primary transition">
                {pair.nameA} <span class="text-muted-foreground font-normal">vs</span> {pair.nameB}
              </div>
              <div class="text-xs text-muted-foreground mt-1">Compare side-by-side &rarr;</div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- 14. Popular Full-Name Combinations -->
    {popularFullNames.length > 0 && (
      <section class="mb-12 p-6 rounded-xl border border-border bg-card">
        <h2 class="font-display text-xl font-bold mb-2 text-foreground">
          Popular Full-Name Combinations for {vm.name}
        </h2>
        <p class="text-xs text-muted-foreground mb-4">
          Estimated frequency of common first-name + surname combinations:
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
          {popularFullNames.map((fn) => (
            <a
              href={`/people/${fn.slug}`}
              class="p-3 rounded-lg border border-border bg-secondary/40 hover:bg-primary/10 hover:border-primary/30 transition text-center group"
            >
              <div class="font-semibold text-foreground group-hover:text-primary transition">{fn.displayName}</div>
              <div class="text-xs text-muted-foreground">~{formatNumber(fn.estimatedPeople)} people</div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- 15. Frequently Asked Questions -->
    <section class="mb-12">
      <h2 class="font-display text-2xl font-bold mb-6 text-foreground">
        Frequently Asked Questions About {vm.name}
      </h2>
      <div class="space-y-4">
        {vm.faqs.map((faq) => (
          <div class="p-5 rounded-xl border border-border bg-card">
            <h3 class="font-semibold text-foreground text-base mb-2">{faq.q}</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">{faq.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Footer Tool CTA -->
    <section class="mt-12">
      <ToolCTA
        headline="Check Another First Name"
        subhead="Search our database of official Social Security &amp; Census records instantly."
      />
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
