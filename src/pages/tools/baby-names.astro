---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../islands/SiteHeader';
import SiteFooter from '../../components/SiteFooter.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import ToolCTA from '../../components/ToolCTA.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import BabyNamesBrowser from '../../islands/tools/BabyNamesBrowser';
import { Top200BabyNamesSection } from '../../islands/tools/Top200BabyNamesSection';
import { DATA_FRESHNESS } from '../../lib/data-freshness';
import manifest from '../../data/metadata/manifest.json';
import {
  Sparkles,
  HelpCircle,
  TrendingUp,
  BarChart3,
  Users,
  ShieldCheck,
  CheckCircle2,
  AlertTriangle,
  ArrowRight,
  Database,
  ArrowRightLeft,
  BookOpen,
  Shuffle,
  Search,
  Layers,
  Heart,
} from 'lucide-react';

const year = DATA_FRESHNESS.latestAvailableBirthYear;
const title = "Baby Names: Popular Boy & Girl Names | HowManyOfMe";
const description = `Explore official ${year} Top 200 baby boy and girl names from the Social Security Administration (released May 2026), browse alphabetically A–Z, and check 140+ years of popularity trends.`;
const canonical = "https://howmanyofme.co/tools/baby-names";

const faqs = [
  {
    q: `What were the most popular baby names in ${year}?`,
    a: `Liam ranked #1 among boys with 20,818 registered births, and Olivia ranked #1 among girls with 13,544 registered births in the official ${year} Social Security Administration baby-name data.`,
  },
  {
    q: `What was the #1 boy name in ${year}?`,
    a: `Liam was the #1 boy name in ${year} with 20,818 registered newborn births across the United States.`,
  },
  {
    q: `What was the #1 girl name in ${year}?`,
    a: `Olivia was the #1 girl name in ${year} with 13,544 registered newborn births across the United States.`,
  },
  {
    q: `How many boys were named Liam in ${year}?`,
    a: `There were 20,818 newborn boys named Liam in ${year} according to official Social Security birth application records.`,
  },
  {
    q: `How many girls were named Olivia in ${year}?`,
    a: `There were 13,544 newborn girls named Olivia in ${year} according to official Social Security birth application records.`,
  },
  {
    q: "Are these the names of all people currently living in the U.S.?",
    a: "No. The annual baby-name ranking measures births and name registrations during a single calendar year. It does not represent the cumulative living population across all age cohorts.",
  },
  {
    q: "How often is the baby-name data updated?",
    a: "The Social Security Administration releases national baby-name data annually (the 2025 cohort was released in May 2026). Our system updates automatically as new official releases become available.",
  },
  {
    q: "Where does the ranking come from?",
    a: "Rankings are sourced directly from official U.S. Social Security Administration card application records for births occurring within the 50 U.S. states and the District of Columbia.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description: description,
    url: canonical,
    inLanguage: "en-US",
    publisher: {
      "@type": "Organization",
      name: "HowManyOfMe",
      url: "https://howmanyofme.co",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: "https://howmanyofme.co",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Tools",
        item: "https://howmanyofme.co/tools",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: "Baby Names",
        item: canonical,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: {
        "@type": "Answer",
        text: f.a,
      },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <SiteHeader client:idle />

  <main class="container py-12 max-w-4xl">
    <!-- Breadcrumbs -->
    <Breadcrumbs
      className="mb-6"
      items={[
        { label: "Home", href: "/" },
        { label: "Tools", href: "/tools" },
        { label: "Baby Names" },
      ]}
    />

    <!-- Header Section -->
    <header class="mb-8">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/10 text-primary font-semibold uppercase tracking-wider text-[11px] mb-3">
        <BookOpen class="h-3.5 w-3.5" /> Baby Names Directory &amp; Discovery Hub
      </span>
      <h1 class="font-display text-3xl md:text-5xl font-bold text-foreground leading-tight tracking-tight">
        Baby Names
      </h1>
      <p class="text-base md:text-lg text-muted-foreground mt-3 leading-relaxed">
        Choosing a baby name starts with discovery. Search thousands of recorded names from official U.S. Social Security archives, browse alphabetically from A to Z, and explore the complete official {year} Top 200 Boy Names and Top 200 Girl Names below.
      </p>
    </header>

    <!-- 1. Interactive A–Z Directory & Search Browser -->
    <section class="my-8 space-y-4">
      <BabyNamesBrowser client:load />
    </section>

    <!-- 2. Top 200 Popular Baby Names Section (Separate Boys & Girls Ranks with Anchor Nav) -->
    <Top200BabyNamesSection client:load />

    <!-- 3. AEO Direct Answer Block -->
    <section class="my-10 rounded-2xl border-l-4 border-primary bg-primary/5 p-6 shadow-xs">
      <h2 class="text-xs font-bold uppercase tracking-wider text-primary mb-1">
        What Are the Most Popular Baby Names in {year}?
      </h2>
      <p class="text-sm md:text-base text-foreground leading-relaxed">
        <strong>Liam</strong> ranked #1 among boys with 20,818 registered births, and <strong>Olivia</strong> ranked #1 among girls with 13,544 registered births in the official {year} Social Security Administration baby-name data (released May 2026).
      </p>
    </section>

    <AdSlot />

    <!-- 4. How Baby Name Rankings Work (5 Practical Steps) -->
    <section class="my-12 space-y-6">
      <h2 class="font-display text-2xl md:text-3xl font-bold text-foreground">
        How Baby Name Rankings Work
      </h2>
      <p class="text-sm md:text-base text-muted-foreground leading-relaxed">
        With thousands of possibilities, finding the perfect name is easiest when approached in clear stages:
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-6">
        <div class="p-5 rounded-2xl border border-border bg-card shadow-xs space-y-2">
          <div class="flex items-center gap-2 font-bold text-foreground text-sm">
            <span class="h-6 w-6 rounded-full bg-primary/10 text-primary flex items-center justify-center text-xs">1</span>
            <span>Browse by Sound &amp; Starting Letter</span>
          </div>
          <p class="text-xs text-muted-foreground leading-relaxed">
            Use the A–Z letter bar above to explore names with phonetic cadences that pair naturally with your surname.
          </p>
        </div>

        <div class="p-5 rounded-2xl border border-border bg-card shadow-xs space-y-2">
          <div class="flex items-center gap-2 font-bold text-foreground text-sm">
            <span class="h-6 w-6 rounded-full bg-primary/10 text-primary flex items-center justify-center text-xs">2</span>
            <span>Check the Ancient Linguistic Meaning</span>
          </div>
          <p class="text-xs text-muted-foreground leading-relaxed">
            Explore authentic Latin, Greek, Hebrew, Celtic, and Sanskrit roots in our <a href="/tools/meaning" class="text-primary underline">Meaning Lookup</a>.
          </p>
        </div>

        <div class="p-5 rounded-2xl border border-border bg-card shadow-xs space-y-2">
          <div class="flex items-center gap-2 font-bold text-foreground text-sm">
            <span class="h-6 w-6 rounded-full bg-primary/10 text-primary flex items-center justify-center text-xs">3</span>
            <span>Check Living Frequency &amp; Rarity</span>
          </div>
          <p class="text-xs text-muted-foreground leading-relaxed">
            Evaluate national rarity ratios and living population scale in the <a href="/tools/popularity-checker" class="text-primary underline">Popularity Checker</a>.
          </p>
        </div>

        <div class="p-5 rounded-2xl border border-border bg-card shadow-xs space-y-2">
          <div class="flex items-center gap-2 font-bold text-foreground text-sm">
            <span class="h-6 w-6 rounded-full bg-primary/10 text-primary flex items-center justify-center text-xs">4</span>
            <span>Plot 140-Year Popularity Curves</span>
          </div>
          <p class="text-xs text-muted-foreground leading-relaxed">
            See if a name is an enduring classic, vintage revival, or fast climber in the <a href="/tools/trend-visualizer" class="text-primary underline">Trend Visualizer</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- 5. What Does a Ranking Mean? (Demographic Distinction) -->
    <section class="my-12 space-y-4">
      <h2 class="font-display text-2xl md:text-3xl font-bold text-foreground">
        What Does a Ranking Mean? (Baby Names vs. Living Population)
      </h2>
      <div class="p-6 rounded-2xl border border-border/80 bg-secondary/30 space-y-3 text-sm text-muted-foreground leading-relaxed">
        <p>
          It is essential to understand the difference between newborn rankings and living population scale:
        </p>
        <ul class="list-disc list-outside pl-5 space-y-1.5">
          <li><strong>Annual Baby Name Rankings:</strong> Measure how many newborn infants received a specific name during a single calendar year (e.g. <em>Liam</em> leading newborn registrations in {year}).</li>
          <li><strong>Cumulative Living Population:</strong> Reflects the total living individuals across all living age groups (e.g. <em>James</em> and <em>Robert</em> having millions of living adult bearers nationwide).</li>
          <li><strong>The HowManyOfMe Ecosystem:</strong> Our site connects both dimensions, allowing you to examine historical newborn waves alongside present-day living bearer estimates.</li>
        </ul>
      </div>
    </section>

    <!-- 6. Federal Data Snapshot & Sources -->
    <section class="my-12 rounded-2xl border border-primary/20 bg-primary/5 p-6 shadow-xs space-y-4">
      <div class="flex items-center justify-between border-b border-primary/15 pb-3">
        <div class="flex items-center gap-2">
          <Database class="h-4 w-4 text-primary" />
          <h3 class="font-display text-lg font-bold text-foreground">Baby Name Data Snapshot</h3>
        </div>
        <span class="text-xs text-muted-foreground">Release Vintage: May 2026</span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
        <div class="p-3 rounded-xl bg-card border border-border">
          <span class="text-muted-foreground block">Birth Year</span>
          <span class="font-bold text-foreground text-sm">{year}</span>
        </div>
        <div class="p-3 rounded-xl bg-card border border-border">
          <span class="text-muted-foreground block">Primary Source</span>
          <span class="font-bold text-foreground text-sm">Social Security Administration</span>
        </div>
        <div class="p-3 rounded-xl bg-card border border-border">
          <span class="text-muted-foreground block">Geographic Scope</span>
          <span class="font-bold text-foreground text-sm">United States</span>
        </div>
        <div class="p-3 rounded-xl bg-card border border-border">
          <span class="text-muted-foreground block">Measured Metric</span>
          <span class="font-bold text-foreground text-sm">Recorded Births</span>
        </div>
      </div>
    </section>

    <!-- 7. Frequently Asked Questions -->
    <section class="my-12 space-y-6">
      <div class="border-b border-border/60 pb-3">
        <h2 class="font-display text-2xl md:text-3xl font-bold text-foreground">
          Frequently Asked Questions About Baby Names
        </h2>
        <p class="text-sm text-muted-foreground mt-1">
          Common questions regarding annual popularity rankings and demographic name data.
        </p>
      </div>

      <div class="space-y-4">
        {faqs.map((faq, idx) => (
          <div class="p-5 rounded-2xl border border-border bg-card shadow-xs space-y-2">
            <h3 class="font-display text-base font-bold text-foreground flex items-center gap-2">
              <HelpCircle class="h-4 w-4 text-primary shrink-0" />
              <span>{faq.q}</span>
            </h3>
            <p class="text-sm text-muted-foreground leading-relaxed pl-6">
              {faq.a}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- 8. Demographic Tools Ecosystem Grid -->
    <section class="my-12 space-y-6">
      <div class="flex items-center justify-between">
        <h2 class="font-display text-2xl md:text-3xl font-bold text-foreground">
          Explore More Demographic Name Tools
        </h2>
        <a href="/tools" class="text-xs font-semibold text-primary hover:underline flex items-center gap-1">
          View All Tools <ArrowRight class="h-3.5 w-3.5" />
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <a
          href="/tools/unique-name-generator"
          class="p-5 rounded-2xl border border-border bg-card hover:border-primary/40 hover:shadow-md transition-all group"
        >
          <div class="flex items-center gap-2 font-bold text-foreground group-hover:text-primary transition-colors text-base mb-1.5">
            <Sparkles class="h-4 w-4 text-primary" />
            <span>Unique Name Generator</span>
          </div>
          <p class="text-xs text-muted-foreground leading-relaxed">
            Filter real baby names by demographic rarity thresholds, starting letters, and length.
          </p>
        </a>

        <a
          href="/tools/popularity-checker"
          class="p-5 rounded-2xl border border-border bg-card hover:border-primary/40 hover:shadow-md transition-all group"
        >
          <div class="flex items-center gap-2 font-bold text-foreground group-hover:text-primary transition-colors text-base mb-1.5">
            <BarChart3 class="h-4 w-4 text-primary" />
            <span>Popularity Checker</span>
          </div>
          <p class="text-xs text-muted-foreground leading-relaxed">
            Check living frequency, national rarity tier, and demographic ratios for any name.
          </p>
        </a>

        <a
          href="/tools/trend-visualizer"
          class="p-5 rounded-2xl border border-border bg-card hover:border-primary/40 hover:shadow-md transition-all group"
        >
          <div class="flex items-center gap-2 font-bold text-foreground group-hover:text-primary transition-colors text-base mb-1.5">
            <TrendingUp class="h-4 w-4 text-primary" />
            <span>Trend Visualizer</span>
          </div>
          <p class="text-xs text-muted-foreground leading-relaxed">
            Compare 140-year multi-decade popularity curves across up to 4 names simultaneously.
          </p>
        </a>
      </div>
    </section>

    <!-- Related Topic Guides & Articles -->
    <RelatedPosts currentSlug="/tools/baby-names" tags={["names", "baby-names", "popularity"]} />

    <!-- Tool Callout -->
    <ToolCTA
      title="Check Living Population for Any Name"
      description="Curious how many living people share a name across all generations? Check living bearer estimates, Census frequencies, and full-name probabilities."
      primaryBtnText="Open Name Checker"
      primaryBtnHref="/"
      secondaryBtnText="Popularity Checker"
      secondaryBtnHref="/tools/popularity-checker"
    />
  </main>

  <SiteFooter />
</BaseLayout>
