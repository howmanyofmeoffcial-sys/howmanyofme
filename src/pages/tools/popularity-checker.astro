---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../islands/SiteHeader';
import SiteFooter from '../../components/SiteFooter.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import ToolCTA from '../../components/ToolCTA.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import PopularityCheckerIsland from '../../islands/tools/PopularityCheckerIsland';
import manifest from '../../data/metadata/manifest.json';
import {
  Sparkles,
  HelpCircle,
  TrendingUp,
  BarChart3,
  Users,
  ShieldCheck,
  CheckCircle2,
  AlertTriangle,
  ArrowRight,
  Database,
  ArrowRightLeft,
  BookOpen,
  Globe,
  Calendar,
} from 'lucide-react';

const title = "How Popular Is My Name? Check Name Popularity & Rarity";
const description = "How popular is your name? Check its popularity rank, national frequency, rarity tiers, and historical trends across 140+ years of official U.S. demographic data.";
const canonical = "https://howmanyofme.co/tools/popularity-checker";

const faqs = [
  {
    q: "How popular is my name in the United States?",
    a: "Name popularity is measured by annual newborn registration rankings from the Social Security Administration (SSA) alongside estimated living bearer populations. Top names like Olivia and Liam rank #1 among newborns, while historical classics like James and Mary maintain the largest cumulative living populations of over 3 million people.",
  },
  {
    q: "How is name popularity calculated?",
    a: "For indexed first names, popularity is calculated from official SSA birth cohort records (1880–2024). We analyze annual birth counts, national rankings per birth year, multi-decade trajectories, and CDC actuarial period life tables to determine living population frequency and rarity.",
  },
  {
    q: "What is the difference between popularity and rarity?",
    a: "Popularity measures how frequently parents choose a name in a given birth year (e.g. Top 10 rank). Rarity measures how uncommon the name is across the entire living population (e.g. fewer than 1 in 17,000 Americans). A name can be currently popular among newborns while still being relatively rare among adults.",
  },
  {
    q: "Is my name unique?",
    a: "In demographic science, very few names are literally unique to a single person. Names with fewer than 2,000 living bearers are classified as 'Very Rare'. For full names, combining an uncommon first name with a rare surname produces distinctive combinations that may only be shared by a handful of living individuals.",
  },
  {
    q: "Can I check how popular my name was when I was born?",
    a: "Yes. In our interactive tool result, you can enter your birth year to see your name's exact national standing, historical cohort size, Western and Chinese Zodiac era, and generational popularity during that specific era.",
  },
  {
    q: "Why does my name have different rankings in different years?",
    a: "Naming fashions shift continuously across generations. A name like Linda ranked #1 in the late 1940s but ranks outside the top 800 today. Conversely, vintage names like Oliver and Hazel have climbed hundreds of rank positions over the past two decades.",
  },
  {
    q: "How many people have my name in the UK?",
    a: "Our calculator is calibrated to official United States federal records (SSA and U.S. Census Bureau). In the United Kingdom, name statistics are collected separately by the Office for National Statistics (ONS) for England & Wales, NRS for Scotland, and NISRA for Northern Ireland, which track annual birth registrations rather than live census directories.",
  },
  {
    q: "Does spelling variation affect name popularity?",
    a: "Yes. Federal statistical agencies record exact character spellings on birth certificates. For example, 'Sophia' (with 'ph') and 'Sofia' (with 'f') are tabulated as separate name records with their own distinct rankings and bearer counts.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description: description,
    url: canonical,
    inLanguage: "en-US",
    publisher: {
      "@type": "Organization",
      name: "HowManyOfMe",
      url: "https://howmanyofme.co",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: "https://howmanyofme.co",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Tools",
        item: "https://howmanyofme.co/tools",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: "Popularity Checker",
        item: canonical,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: {
        "@type": "Answer",
        text: f.a,
      },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <SiteHeader client:idle />

  <main class="container py-12 max-w-4xl">
    <!-- Breadcrumbs -->
    <Breadcrumbs
      className="mb-6"
      items={[
        { label: "Home", href: "/" },
        { label: "Tools", href: "/tools" },
        { label: "Popularity Checker" },
      ]}
    />

    <!-- Header Section -->
    <header class="mb-8">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/10 text-primary font-semibold uppercase tracking-wider text-[11px] mb-3">
        <Sparkles class="h-3.5 w-3.5" /> Name Popularity &amp; Rarity Calculator
      </span>
      <h1 class="font-display text-3xl md:text-5xl font-bold text-foreground leading-tight tracking-tight">
        How Popular Is My Name?
      </h1>
      <p class="text-base md:text-lg text-muted-foreground mt-3 leading-relaxed">
        Discover where your name stands in American history. Enter any first name, surname, or full name below to analyze historical popularity rankings, 140-year decade trajectories, living bearer frequency, and rarity tiers.
      </p>
    </header>

    <!-- 1. Interactive Tool Container (Above the Fold) -->
    <section class="my-8">
      <PopularityCheckerIsland client:load />
    </section>

    <!-- 2. Quick Answer Block (AEO / Snippet Ready) -->
    <section class="my-10 rounded-2xl border-l-4 border-primary bg-primary/5 p-6 shadow-sm">
      <h2 class="text-xs font-bold uppercase tracking-wider text-primary mb-1">
        Quick Answer: What Determines Name Popularity?
      </h2>
      <p class="text-sm md:text-base text-foreground leading-relaxed">
        A name's popularity is defined by two complementary metrics: <strong>annual newborn ranking</strong> (how many parents chose the name in a given year) and <strong>cumulative demographic frequency</strong> (how many living people share the name across all generations). In the United States, official Social Security Administration archives track every registered birth from 1880 to 2024 to map these historical curves.
      </p>
    </section>

    <AdSlot />

    <!-- 3. Popularity vs Commonness vs Rarity vs Uniqueness -->
    <section class="my-12 space-y-6">
      <h2 class="font-display text-2xl md:text-3xl font-bold text-foreground">
        Popularity vs. Commonness vs. Rarity: What's the Difference?
      </h2>
      <p class="text-sm md:text-base text-muted-foreground leading-relaxed">
        While people often use these terms interchangeably, in demographic analysis they answer four completely distinct questions:
      </p>

      <div class="overflow-x-auto rounded-2xl border border-border bg-card shadow-xs my-6">
        <table class="w-full text-left text-sm border-collapse">
          <thead class="bg-secondary/70 text-xs font-semibold text-foreground uppercase tracking-wider border-b border-border">
            <tr>
              <th scope="col" class="p-3.5">Term</th>
              <th scope="col" class="p-3.5">Core Question</th>
              <th scope="col" class="p-3.5">How It Is Measured</th>
              <th scope="col" class="p-3.5">Real Example</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border/60">
            <tr class="hover:bg-secondary/20 transition-colors">
              <th scope="row" class="p-3.5 font-semibold text-foreground">Popularity</th>
              <td class="p-3.5">How fashionable is the name for babies today?</td>
              <td class="p-3.5">Annual birth registrations &amp; national rank.</td>
              <td class="p-3.5 text-xs text-muted-foreground"><em>Liam</em> (#1 for newborns today).</td>
            </tr>
            <tr class="hover:bg-secondary/20 transition-colors">
              <th scope="row" class="p-3.5 font-semibold text-foreground">Commonness</th>
              <td class="p-3.5">How many living people of all ages have it?</td>
              <td class="p-3.5">Cumulative multi-generational living cohort.</td>
              <td class="p-3.5 text-xs text-muted-foreground"><em>James</em> (~3.2M living Americans).</td>
            </tr>
            <tr class="hover:bg-secondary/20 transition-colors">
              <th scope="row" class="p-3.5 font-semibold text-foreground">Rarity</th>
              <td class="p-3.5">How unusual is it relative to the population?</td>
              <td class="p-3.5">National frequency ratio (1 in X people).</td>
              <td class="p-3.5 text-xs text-muted-foreground"><em>Silas</em> (1 in ~6,800 people).</td>
            </tr>
            <tr class="hover:bg-secondary/20 transition-colors">
              <th scope="row" class="p-3.5 font-semibold text-foreground">Uniqueness</th>
              <td class="p-3.5">Is it shared by only a tiny handful of people?</td>
              <td class="p-3.5">Combined full-name joint probability.</td>
              <td class="p-3.5 text-xs text-muted-foreground">Rare first name + rare surname combination.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- 4. How Common Is My Name? (The 5 Demographic Tiers) -->
    <section class="my-12 space-y-6">
      <h2 class="font-display text-2xl md:text-3xl font-bold text-foreground">
        How Common Is My Name? (The 5 Demographic Frequency Tiers)
      </h2>
      <p class="text-sm md:text-base text-muted-foreground leading-relaxed">
        Based on official U.S. population records, we classify name frequency into five calibrated tiers:
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 my-6">
        <div class="p-5 rounded-2xl border border-border bg-card shadow-xs">
          <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400 block mb-1">
            500,000+ Living
          </span>
          <h3 class="font-display text-lg font-bold text-foreground">Very Common</h3>
          <p class="text-xs text-muted-foreground mt-2 leading-relaxed">
            1 in every 10 to 600 Americans. Shared across every generation and widely recognized everywhere. Examples: <em>James, Mary, Robert, John, Michael, Jennifer</em>.
          </p>
        </div>

        <div class="p-5 rounded-2xl border border-border bg-card shadow-xs">
          <span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400 block mb-1">
            100,000 – 499,999 Living
          </span>
          <h3 class="font-display text-lg font-bold text-foreground">Common</h3>
          <p class="text-xs text-muted-foreground mt-2 leading-relaxed">
            1 in every 700 to 3,300 Americans. Well-known and likely shared by multiple peers in school or work. Examples: <em>Alexander, Sarah, Brandon, Ethan, Megan</em>.
          </p>
        </div>

        <div class="p-5 rounded-2xl border border-border bg-card shadow-xs">
          <span class="text-xs font-bold uppercase tracking-wider text-teal-600 dark:text-teal-400 block mb-1">
            20,000 – 99,999 Living
          </span>
          <h3 class="font-display text-lg font-bold text-foreground">Uncommon</h3>
          <p class="text-xs text-muted-foreground mt-2 leading-relaxed">
            1 in every 3,400 to 16,000 Americans. Familiar and easy to pronounce, but rarely shared by multiple classmates. Examples: <em>Gideon, Fiona, Silas, Malcolm, Nina</em>.
          </p>
        </div>

        <div class="p-5 rounded-2xl border border-border bg-card shadow-xs">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400 block mb-1">
            2,000 – 19,999 Living
          </span>
          <h3 class="font-display text-lg font-bold text-foreground">Rare</h3>
          <p class="text-xs text-muted-foreground mt-2 leading-relaxed">
            1 in every 17,000 to 160,000 Americans. Distinctive and memorable in any community or workplace. Examples: <em>Lysander, Cosima, Zephyr, Elowen, Cormac</em>.
          </p>
        </div>

        <div class="p-5 rounded-2xl border border-border bg-card shadow-xs sm:col-span-2 lg:col-span-2">
          <span class="text-xs font-bold uppercase tracking-wider text-purple-600 dark:text-purple-400 block mb-1">
            Under 2,000 Living
          </span>
          <h3 class="font-display text-lg font-bold text-foreground">Very Rare</h3>
          <p class="text-xs text-muted-foreground mt-2 leading-relaxed">
            Fewer than 1 in 170,000 Americans. Highly unusual, including ancient heritage names, adapted surnames, and emerging global names. Examples: <em>Thalassa, Peregrine, Callidora</em>.
          </p>
        </div>
      </div>
    </section>

    <!-- 5. How Name Popularity Changes Over Time (4 Lifecycles) -->
    <section class="my-12 space-y-4">
      <h2 class="font-display text-2xl md:text-3xl font-bold text-foreground">
        How Has Name Popularity Changed Over Time? (The 4 Lifecycle Curves)
      </h2>
      <p class="text-sm md:text-base text-muted-foreground leading-relaxed">
        Over 140+ years of demographic record-keeping, American naming patterns follow four recognizable lifecycle trajectories:
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-6">
        <div class="p-5 rounded-2xl border border-border bg-card shadow-xs">
          <h3 class="font-bold text-foreground text-base mb-1">1. The 100-Year Vintage Revival</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">
            Names that peaked around the turn of the 20th century (1890s–1920s), vanished for two generations, and are now top choices for modern parents (e.g. <em>Oliver, Hazel, Theodore, Emma</em>).
          </p>
        </div>

        <div class="p-5 rounded-2xl border border-border bg-card shadow-xs">
          <h3 class="font-bold text-foreground text-base mb-1">2. The Enduring Classic</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">
            Names that have remained continuously in the national Top 50 across more than a century (e.g. <em>William, Elizabeth, Thomas, James</em>), building massive multi-generational populations.
          </p>
        </div>

        <div class="p-5 rounded-2xl border border-border bg-card shadow-xs">
          <h3 class="font-bold text-foreground text-base mb-1">3. The Mid-Century Wave</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">
            Names that experienced massive spikes between 1940 and 1970 (e.g. <em>Linda, Gary, Deborah, Donna</em>). Highly common among baby boomers, but rare among modern newborns.
          </p>
        </div>

        <div class="p-5 rounded-2xl border border-border bg-card shadow-xs">
          <h3 class="font-bold text-foreground text-base mb-1">4. The Rapid Modern Spike</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">
            Contemporary names that surged from unranked to Top 100 in less than a decade due to media, pop culture, or phonetic trends (e.g. <em>Nova, Kai, Harper, Luna</em>).
          </p>
        </div>
      </div>
    </section>

    <!-- 6. Was Your Name Popular When You Were Born? -->
    <section class="my-12 space-y-4">
      <div class="flex items-center gap-2">
        <Calendar class="h-5 w-5 text-primary" />
        <h2 class="font-display text-2xl md:text-3xl font-bold text-foreground">
          Was Your Name Popular When You Were Born?
        </h2>
      </div>
      <p class="text-sm md:text-base text-muted-foreground leading-relaxed">
        A name's perceived popularity depends heavily on your generation. In our interactive tool result, entering your birth year unlocks exact generational cohort insights:
      </p>

      <ul class="list-disc list-outside pl-6 space-y-2 text-sm md:text-base text-muted-foreground leading-relaxed">
        <li><strong class="text-foreground">Baby Boomers (1946–1964):</strong> Dominated by post-war classics like <em>Mary, Linda, James, Robert</em>, and <em>Michael</em>.</li>
        <li><strong class="text-foreground">Generation X (1965–1980):</strong> Led by mid-century shifts toward <em>Jennifer, Amy, Jason, Christopher</em>, and <em>Brian</em>.</li>
        <li><strong class="text-foreground">Millennials (1981–1996):</strong> Characterized by the peak popularity of <em>Jessica, Ashley, Joshua, Matthew</em>, and <em>Amanda</em>.</li>
        <li><strong class="text-foreground">Generation Z (1997–2012):</strong> Defined by the rise of <em>Emily, Madison, Jacob, Ethan</em>, and <em>Tyler</em>.</li>
        <li><strong class="text-foreground">Generation Alpha (2013–Present):</strong> Led by vintage revivals and modern nature names like <em>Olivia, Emma, Liam, Noah</em>, and <em>Oliver</em>.</li>
      </ul>
    </section>

    <!-- 7. Worked Case Studies -->
    <section class="my-12 space-y-6">
      <h2 class="font-display text-2xl md:text-3xl font-bold text-foreground">
        Real-World Popularity Case Studies
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Case 1: Olivia -->
        <div class="p-6 rounded-2xl border border-border bg-card shadow-xs space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-primary">
              Modern Popularity Leader
            </span>
            <span class="px-2 py-0.5 rounded text-[10px] bg-secondary font-bold text-foreground">Rank #1</span>
          </div>
          <h3 class="font-display text-xl font-bold text-foreground">Name: Olivia</h3>
          <ul class="text-xs text-muted-foreground space-y-1.5">
            <li>• <strong>Newborn Popularity:</strong> Ranked #1 among female births recently</li>
            <li>• <strong>Historical Peak:</strong> 2021 (~17,800 births/yr)</li>
            <li>• <strong>Living Bearers:</strong> ~580,000 living Americans (Very Common)</li>
            <li>• <strong>National Ratio:</strong> 1 in ~580 Americans</li>
          </ul>
          <p class="text-xs text-muted-foreground leading-relaxed pt-2 border-t border-border/50">
            <strong>Key Insight:</strong> While Olivia is the most popular girl name for babies born today, it represents a relatively young demographic cohort with most bearers under age 25.
          </p>
        </div>

        <!-- Case 2: José / Rahul -->
        <div class="p-6 rounded-2xl border border-border bg-card shadow-xs space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
              International &amp; Cultural Popularity
            </span>
            <span class="px-2 py-0.5 rounded text-[10px] bg-secondary font-bold text-foreground">Global Focus</span>
          </div>
          <h3 class="font-display text-xl font-bold text-foreground">Name: José / Rahul</h3>
          <ul class="text-xs text-muted-foreground space-y-1.5">
            <li>• <strong>José:</strong> ~560,000 living bearers in U.S. records (Very Common)</li>
            <li>• <strong>Rahul:</strong> ~50,000 living bearers (Uncommon demographic bracket)</li>
            <li>• <strong>Data Scope:</strong> Calibrated to U.S. resident populations</li>
          </ul>
          <p class="text-xs text-muted-foreground leading-relaxed pt-2 border-t border-border/50">
            <strong>Key Insight:</strong> A name can be one of the most popular names globally while having an uncommon or modelled frequency within U.S. federal archives.
          </p>
        </div>
      </div>
    </section>

    <!-- 8. How Many People Have My Name in the UK? -->
    <section class="my-12 space-y-4">
      <div class="flex items-center gap-2">
        <Globe class="h-5 w-5 text-primary" />
        <h2 class="font-display text-2xl md:text-3xl font-bold text-foreground">
          How Many People Have My Name in the UK?
        </h2>
      </div>
      <div class="p-6 rounded-2xl border border-border/80 bg-secondary/30 space-y-3 text-sm text-muted-foreground leading-relaxed">
        <p>
          Many users search for British name frequencies alongside U.S. statistics. It is important to understand how UK demographic records differ:
        </p>
        <ul class="list-disc list-outside pl-5 space-y-1.5">
          <li><strong>Separate Official Registries:</strong> In the UK, baby name statistics are published by the <strong>Office for National Statistics (ONS)</strong> for England &amp; Wales, <strong>National Records of Scotland (NRS)</strong>, and <strong>NISRA</strong> for Northern Ireland.</li>
          <li><strong>Annual Births vs. Living Population:</strong> Just like the U.S. SSA, the ONS publishes annual birth counts by year, not an active real-time directory of every living citizen.</li>
          <li><strong>Current Tool Scope:</strong> Our calculator operates strictly on official United States federal datasets. While UK popularity often mirrors U.S. trends (e.g. <em>Olivia</em> and <em>Noah</em> ranking high in both nations), living population numbers cannot be directly applied across countries.</li>
        </ul>
      </div>
    </section>

    <!-- 9. Does Spelling Affect Popularity? -->
    <section class="my-12 space-y-4">
      <h2 class="font-display text-2xl md:text-3xl font-bold text-foreground">
        Does Spelling Affect Name Popularity?
      </h2>
      <p class="text-sm md:text-base text-muted-foreground leading-relaxed">
        Yes. In federal demographic databases, each spelling is treated as an independent entry:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-4">
        <div class="p-4 rounded-xl bg-card border border-border text-xs text-muted-foreground space-y-1">
          <strong class="text-foreground text-sm block">Sophia vs. Sofia</strong>
          <p><em>Sophia</em> (with 'ph') has historically accumulated more total registrations in the U.S., while <em>Sofia</em> (with 'f') is widely popular in Spanish and Italian traditions.</p>
        </div>
        <div class="p-4 rounded-xl bg-card border border-border text-xs text-muted-foreground space-y-1">
          <strong class="text-foreground text-sm block">Sara vs. Sarah</strong>
          <p><em>Sarah</em> (with 'h') ranks as an enduring multi-decade Top 10 classic, while <em>Sara</em> represents a smaller, distinct demographic cohort.</p>
        </div>
      </div>
    </section>

    <!-- 10. Demographic Tools Ecosystem -->
    <section class="my-12 space-y-6">
      <div class="flex items-center justify-between">
        <h2 class="font-display text-2xl md:text-3xl font-bold text-foreground">
          Explore More Demographic Name Tools
        </h2>
        <a href="/tools" class="text-xs font-semibold text-primary hover:underline flex items-center gap-1">
          View All Tools <ArrowRight class="h-3.5 w-3.5" />
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <a
          href="/tools/name-comparison"
          class="p-5 rounded-2xl border border-border bg-card hover:border-primary/40 hover:shadow-md transition-all group"
        >
          <div class="flex items-center gap-2 font-bold text-foreground group-hover:text-primary transition-colors text-base mb-1.5">
            <ArrowRightLeft class="h-4 w-4 text-primary" />
            <span>Name Comparison Tool</span>
          </div>
          <p class="text-xs text-muted-foreground leading-relaxed">
            Compare two names head-to-head on popularity, living count, and historical trajectory.
          </p>
        </a>

        <a
          href="/tools/trend-visualizer"
          class="p-5 rounded-2xl border border-border bg-card hover:border-primary/40 hover:shadow-md transition-all group"
        >
          <div class="flex items-center gap-2 font-bold text-foreground group-hover:text-primary transition-colors text-base mb-1.5">
            <TrendingUp class="h-4 w-4 text-primary" />
            <span>Trend Visualizer</span>
          </div>
          <p class="text-xs text-muted-foreground leading-relaxed">
            Plot multi-decade popularity curves for up to 4 names simultaneously across 1880–2024.
          </p>
        </a>

        <a
          href="/tools/popularity-guide"
          class="p-5 rounded-2xl border border-border bg-card hover:border-primary/40 hover:shadow-md transition-all group"
        >
          <div class="flex items-center gap-2 font-bold text-foreground group-hover:text-primary transition-colors text-base mb-1.5">
            <BookOpen class="h-4 w-4 text-primary" />
            <span>Popularity Guide</span>
          </div>
          <p class="text-xs text-muted-foreground leading-relaxed">
            Comprehensive educational guide to understanding ranks, frequency ratios, and cohorts.
          </p>
        </a>
      </div>
    </section>

    <!-- 11. Federal Data Snapshot -->
    <section class="my-12 rounded-2xl border border-primary/20 bg-primary/5 p-6 shadow-xs space-y-4">
      <div class="flex items-center justify-between border-b border-primary/15 pb-3">
        <div class="flex items-center gap-2">
          <Database class="h-4 w-4 text-primary" />
          <h3 class="font-display text-lg font-bold text-foreground">Federal Data Snapshot</h3>
        </div>
        <span class="text-xs text-muted-foreground">Release: {manifest.datasetVersion}</span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
        <div class="p-3 rounded-xl bg-card border border-border">
          <span class="text-muted-foreground block">Geographic Scope</span>
          <strong class="text-foreground text-sm font-bold">United States</strong>
        </div>
        <div class="p-3 rounded-xl bg-card border border-border">
          <span class="text-muted-foreground block">First-Name Archive</span>
          <strong class="text-foreground text-sm font-bold">SSA 1880–2024</strong>
        </div>
        <div class="p-3 rounded-xl bg-card border border-border">
          <span class="text-muted-foreground block">Surname Tabulations</span>
          <strong class="text-foreground text-sm font-bold">U.S. Census Bureau</strong>
        </div>
        <div class="p-3 rounded-xl bg-card border border-border">
          <span class="text-muted-foreground block">Actuarial Calibration</span>
          <strong class="text-foreground text-sm font-bold">CDC Life Tables</strong>
        </div>
      </div>
    </section>

    <!-- 12. Common Questions (FAQ Section) -->
    <section class="my-12 space-y-6">
      <div class="flex items-center gap-2">
        <HelpCircle class="h-5 w-5 text-primary" />
        <h2 class="font-display text-2xl md:text-3xl font-bold text-foreground">
          Frequently Asked Questions About Name Popularity &amp; Rarity
        </h2>
      </div>

      <div class="space-y-4">
        {faqs.map((f) => (
          <div class="p-6 rounded-2xl border border-border bg-card shadow-xs">
            <h3 class="font-semibold text-foreground text-base mb-2">{f.q}</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 13. Final CTA -->
    <ToolCTA
      headline="Explore Your Name's Popularity Today"
      subhead="Enter your first name, surname, or full name above to analyze rankings, historical curves, and demographic rarity."
    />

    <RelatedPosts currentSlug="popularity-checker" tags={["popularity", "tools", "trends"]} count={6} />
  </main>

  <SiteFooter />
</BaseLayout>
