---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../islands/SiteHeader';
import SiteFooter from '../components/SiteFooter.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ToolCTA from '../components/ToolCTA.astro';
import { Users, Database, Globe, BarChart3, ExternalLink } from 'lucide-react';

const title = "About HowManyOfMe — U.S. Name Demographics & Creator Story";
const description = "Learn about HowManyOfMe, the platform that answers 'how many people have my name?' Discover name popularity, rarity rankings, and evidence-based demographic data.";
const canonical = "https://howmanyofme.co/about";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    name: "About HowManyOfMe",
    description: "Learn about the creator and mission behind HowManyOfMe, a name statistics platform covering official U.S. demographic data.",
    url: "https://howmanyofme.co/about",
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Ziven Borceg",
    url: "https://medium.com/@zivenborceg",
    sameAs: ["https://medium.com/@zivenborceg"],
    jobTitle: "Creator of HowManyOfMe",
  },
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <SiteHeader client:idle />

  <main class="container py-12 max-w-3xl">
    <Breadcrumbs
      className="mb-6"
      items={[
        { label: "Home", href: "/" },
        { label: "About" },
      ]}
    />

    <h1 class="font-display text-4xl md:text-5xl font-bold mb-6 text-foreground">
      About HowManyOfMe
    </h1>
    <p class="text-lg text-muted-foreground mb-10 leading-relaxed">
      Ever wondered "how many people have my name?" or "how common is my name in the United States?" — you're in the right place. HowManyOfMe provides clean, transparent demographic name insights derived from official government datasets and actuarial models.
    </p>

    <!-- Stats Grid -->
    <div class="grid grid-cols-2 gap-4 mb-14">
      <div class="p-5 rounded-xl border border-border bg-card text-center">
        <Database className="h-6 w-6 text-primary mx-auto mb-2" />
        <div class="text-2xl font-bold text-foreground">1880–2024</div>
        <div class="text-sm text-muted-foreground">SSA Cohort Records</div>
      </div>
      <div class="p-5 rounded-xl border border-border bg-card text-center">
        <Globe className="h-6 w-6 text-primary mx-auto mb-2" />
        <div class="text-2xl font-bold text-foreground">2020 Census</div>
        <div class="text-sm text-muted-foreground">Decennial Tabulations</div>
      </div>
      <div class="p-5 rounded-xl border border-border bg-card text-center">
        <Users className="h-6 w-6 text-primary mx-auto mb-2" />
        <div class="text-2xl font-bold text-foreground">330M+</div>
        <div class="text-sm text-muted-foreground">U.S. Population Baseline</div>
      </div>
      <div class="p-5 rounded-xl border border-border bg-card text-center">
        <BarChart3 className="h-6 w-6 text-primary mx-auto mb-2" />
        <div class="text-2xl font-bold text-foreground">145 Yrs</div>
        <div class="text-sm text-muted-foreground">Historical Cohort Span</div>
      </div>
    </div>

    <!-- Creator Section -->
    <section class="mb-12">
      <h2 class="font-display text-2xl font-bold mb-4 text-foreground">Meet the Creator</h2>
      <p class="text-muted-foreground leading-relaxed mb-3">
        I'm <strong class="text-foreground">Ziven Borceg</strong> — a builder, tinkerer, and someone who genuinely enjoys making useful things on the internet. I've always been drawn to the intersection of data and everyday curiosity.
      </p>
      <p class="text-muted-foreground leading-relaxed mb-4">
        You can read more of my writing and follow what I'm building on <a href="https://medium.com/@zivenborceg" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline inline-flex items-center gap-1 font-medium">Medium <ExternalLink className="h-3 w-3 inline" /></a>.
      </p>
    </section>

    <!-- Mission -->
    <section class="mb-12">
      <h2 class="font-display text-2xl font-bold mb-4 text-foreground">Why HowManyOfMe Exists</h2>
      <p class="text-muted-foreground leading-relaxed mb-3">
        Most name websites fall into one of two camps: dry government archives that are impossible to search, or content farms that give you a generic "your name means beloved" paragraph without any real data.
      </p>
      <p class="text-muted-foreground leading-relaxed">
        HowManyOfMe takes official census figures, birth registries, and demographic records, runs them through statistical models, and serves them up in clean, interactive reports.
      </p>
    </section>

    <ToolCTA
      headline="Try the free name search tool"
      subhead="Enter any first name and discover how many people share it worldwide."
    />
  </main>

  <SiteFooter />
</BaseLayout>
