---
import { getIndexableNames, getName, type NameRecord } from '../../../lib/names';
import { buildNameEntityProfile } from '../../../lib/names/entityProfile';
import { getNameAbsoluteUrl } from '../../../lib/seo/canonicalUrl';
import { formatNumber } from '../../../data/nameData';

export async function getStaticPaths() {
  const allNames = getIndexableNames();

  return allNames.map((record) => ({
    params: { name: record.slug },
    props: { record },
  }));
}

interface Props {
  record?: NameRecord;
}

const { name: rawName } = Astro.params;
const { record: propsRecord } = Astro.props;

const data = propsRecord || getName(rawName || '', false);

if (!data) {
  return Astro.redirect('/404');
}

const profile = buildNameEntityProfile(data);
const canonicalUrl = getNameAbsoluteUrl(profile.name);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{profile.name} Name Frequency Badge</title>
    <style>
      :root {
        --bg: #ffffff;
        --card: #f8fafc;
        --border: #e2e8f0;
        --text: #0f172a;
        --muted: #64748b;
        --primary: #2563eb;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0b0f17;
          --card: #131b2e;
          --border: #1e293b;
          --text: #f8fafc;
          --muted: #94a3b8;
          --primary: #3b82f6;
        }
      }
      body {
        margin: 0;
        padding: 12px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: var(--bg);
        color: var(--text);
        box-sizing: border-box;
      }
      .badge {
        padding: 16px;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        gap: 8px;
      }
      .header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
      }
      .name {
        font-size: 1.25rem;
        font-weight: 700;
        margin: 0;
      }
      .rank {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--primary);
      }
      .stat-row {
        display: flex;
        gap: 12px;
        margin: 4px 0;
      }
      .stat-box {
        flex: 1;
        background: var(--bg);
        padding: 8px 10px;
        border-radius: 8px;
        border: 1px solid var(--border);
      }
      .stat-label {
        font-size: 0.65rem;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .stat-val {
        font-size: 1.1rem;
        font-weight: 700;
      }
      .footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.7rem;
        color: var(--muted);
        padding-top: 6px;
        border-top: 1px solid var(--border);
      }
      .footer a {
        color: var(--primary);
        text-decoration: none;
        font-weight: 600;
      }
      .footer a:hover {
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <div class="badge">
      <div class="header">
        <h3 class="name">{profile.name}</h3>
        <span class="rank">All-Time Rank #{formatNumber(profile.rank)}</span>
      </div>

      <div class="stat-row">
        <div class="stat-box">
          <div class="stat-label">Estimated Living</div>
          <div class="stat-val">~{formatNumber(profile.stats.estimatedLivingPeople)}</div>
        </div>
        <div class="stat-box">
          <div class="stat-label">Peak Year</div>
          <div class="stat-val">{profile.stats.peakYear}</div>
        </div>
      </div>

      <div class="footer">
        <span>SSA 1880–2024</span>
        <a href={canonicalUrl} target="_blank" rel="noopener noreferrer">
          Source: HowManyOfMe.co &rarr;
        </a>
      </div>
    </div>
  </body>
</html>
