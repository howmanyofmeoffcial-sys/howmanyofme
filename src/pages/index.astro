---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../islands/SiteHeader';
import NameSearchHero from '../islands/NameSearchHero';
import SiteFooter from '../components/SiteFooter.astro';
import AdSlot from '../components/AdSlot.astro';
import { getPopularNames, formatNumber } from '../data/nameData';
import { PopularBabyNamesSection } from '../islands/homepage/PopularBabyNamesSection';
import { getAllSurnames } from '../lib/surnames/data';
import { getSurnameUrl } from '../lib/surnames/url';
import manifest from '../data/metadata/manifest.json';

const popularNames = getPopularNames().slice(0, 15);
const popularSurnames = getAllSurnames().slice(0, 15);

const popularFullNames = [
  { first: "James", last: "Smith", slug: "james-smith" },
  { first: "Mary", last: "Johnson", slug: "mary-johnson" },
  { first: "Robert", last: "Williams", slug: "robert-williams" },
  { first: "Patricia", last: "Brown", slug: "patricia-brown" },
  { first: "John", last: "Jones", slug: "john-jones" },
  { first: "Jennifer", last: "Garcia", slug: "jennifer-garcia" },
  { first: "Michael", last: "Miller", slug: "michael-miller" },
  { first: "Linda", last: "Davis", slug: "linda-davis" },
];

const faqs = [
  {
    q: "How many people have my name in the United States?",
    a: "You can check your first name, last name, or full name using our lookup tool above. For indexed names, we combine official Social Security Administration (SSA) birth records spanning 1880 to 2024 with actuarial life tables to estimate living bearers. For names outside the indexed dataset, we provide a clearly labeled statistical estimate.",
  },
  {
    q: "Can I check how many people have my last name (surname)?",
    a: "Yes. You can switch to the Full Name mode or browse our surnames directory to see frequency statistics from the U.S. Census Bureau, including national ranking and frequency per 100,000 residents.",
  },
  {
    q: "How does the full-name combination checker work?",
    a: "When you check a full name (e.g., 'James Smith'), we compute the joint demographic frequency by combining the first-name living population with the Census surname probability under statistical independence, estimating the number of living U.S. individuals sharing both names.",
  },
  {
    q: "Is the result an exact census count or an estimate?",
    a: "Demographic counts for indexed names are calculated from official government records (SSA birth cohorts and Census data) adjusted by actuarial survival rates. For unindexed names, values are modeled statistical estimates. Neither is a live surveillance headcount of every living citizen.",
  },
  {
    q: "How is a modeled statistical estimate calculated?",
    a: "When a name is not present in the primary top-name records, our system applies a deterministic demographic frequency model based on U.S. name distributions to provide a realistic rarity bracket rather than fabricating an arbitrary number.",
  },
  {
    q: "Where does the data come from?",
    a: "Our data is derived directly from public domain U.S. government datasets: Social Security Administration card application records (1880–2024), U.S. Census Bureau tabulations, and CDC actuarial life tables.",
  },
  {
    q: "Why might another website show a different number?",
    a: "Different websites use different methodologies. Some only display total historical births without adjusting for mortality, some use only recent single-year birth counts, and others use self-reported phone directory listings. HowManyOfMe calculates estimated living bearers based on historical cohort survival.",
  },
  {
    q: "How current is the data?",
    a: `Our dataset includes Social Security birth records through the ${manifest.sources.ssa.latestAvailableYear} calendar year (the most recent annual government release) and U.S. Census Bureau frequency tabulations.`,
  },
  {
    q: "Do I need to sign up or create an account?",
    a: "No. HowManyOfMe is completely free to use with no registration, no account creation, and no software download required.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "HowManyOfMe",
    url: "https://howmanyofme.co",
    description: "U.S. Name Demographics, Popularity Statistics & Living Population Estimates",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Popular Given Names in the United States",
    itemListElement: popularNames.map((n, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: `https://howmanyofme.co/name/${n.name}`,
      name: n.name,
    })),
  },
];

const canonical = 'https://howmanyofme.co';
---

<BaseLayout
  title="How Many of Me? Find Out How Many People Have Your Name in 2026"
  description="Check how common your first name, last name, or full name may be in the U.S. Get source-backed statistics where available and clearly labelled estimates for names outside the main dataset."
  canonical={canonical}
  jsonLd={jsonLd}
>
  <SiteHeader client:idle />
  <NameSearchHero client:load />

  <main class="container py-8 md:py-12">
    <!-- Section 1: AEO Summary & What This Estimate Means -->
    <section class="homepage-section max-w-4xl mx-auto">
      <div class="rounded-2xl border border-border/80 bg-card p-6 md:p-8 shadow-sm space-y-6">
        <div>
          <h2 class="font-display text-2xl md:text-3xl font-bold text-foreground mb-2">
            What Does the Name Estimate Mean?
          </h2>
          <p class="text-muted-foreground text-sm md:text-base leading-relaxed">
            HowManyOfMe estimates how common a name may be in the United States by analyzing official public records. We clearly differentiate between verified government records and demographic models:
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
          <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-4 space-y-2">
            <div class="flex items-center gap-2 text-emerald-700 dark:text-emerald-400 font-semibold text-sm">
              <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
              Source-Backed Profile
            </div>
            <p class="text-xs md:text-sm text-muted-foreground leading-relaxed">
              Calculated directly from Social Security Administration birth cohorts (1880–{manifest.sources.ssa.latestAvailableYear}) combined with CDC actuarial survival curves for living bearer estimation.
            </p>
          </div>

          <div class="rounded-xl border border-amber-500/20 bg-amber-500/5 p-4 space-y-2">
            <div class="flex items-center gap-2 text-amber-700 dark:text-amber-400 font-semibold text-sm">
              <span class="h-2 w-2 rounded-full bg-amber-500"></span>
              Statistical Estimate
            </div>
            <p class="text-xs md:text-sm text-muted-foreground leading-relaxed">
              A modelled demographic frequency estimate for unindexed names outside the top Social Security records, providing a realistic frequency bracket without fabricating false rankings.
            </p>
          </div>
        </div>

        <p class="text-xs text-muted-foreground pt-1 border-t border-border/60">
          <strong>Note:</strong> Public demographic counts reflect statistical estimates and registered birth cohorts, not a live census headcount of every living citizen.
        </p>
      </div>
    </section>

    <!-- Section 2: Popular Baby Names in 2026 (Official SSA Data) -->
    <section class="homepage-section">
      <PopularBabyNamesSection client:load />
    </section>

    <!-- Ad Slot 1: Mid-content upper break -->
    <div class="homepage-ad-break">
      <AdSlot format="responsive" />
    </div>

    <!-- Section 3: Popular Surnames -->
    <section class="homepage-section space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-border/60 pb-4">
        <div>
          <h2 class="font-display text-2xl md:text-3xl font-bold text-foreground">
            Popular U.S. Surnames
          </h2>
          <p class="text-sm text-muted-foreground mt-1">
            Frequently occurring surnames from Decennial U.S. Census returns
          </p>
        </div>
        <a href="/last-names" class="text-sm font-semibold text-primary hover:underline inline-flex items-center gap-1 shrink-0">
          Browse all surnames →
        </a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3">
        {popularSurnames.map((s) => (
          <a
            href={getSurnameUrl(s.name)}
            class="p-4 rounded-xl border border-border bg-card hover:border-primary/50 hover:shadow-md transition-all group block"
          >
            <div class="flex items-center justify-between mb-1.5">
              <span class="font-bold text-foreground group-hover:text-primary transition-colors">{s.name}</span>
              <span class="text-[10px] font-bold text-muted-foreground">
                #{s.rank}
              </span>
            </div>
            <div class="text-xs text-muted-foreground">~{formatNumber(s.count)} in Census</div>
          </a>
        ))}
      </div>
    </section>

    <!-- Section 4: Full-Name Discovery & Combinations -->
    <section class="homepage-section rounded-2xl border border-border/80 bg-secondary/30 p-6 md:p-8 space-y-6">
      <div class="max-w-2xl">
        <h2 class="font-display text-2xl md:text-3xl font-bold text-foreground mb-2">
          Check a Full Name Combination
        </h2>
        <p class="text-sm md:text-base text-muted-foreground leading-relaxed">
          Curious how common your exact first and last name combination is? We calculate joint demographic probabilities using first-name cohort frequencies and Census surname distributions.
        </p>
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-3">
          Popular Full-Name Combinations
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
          {popularFullNames.map((fn) => (
            <a
              href={`/people/${fn.slug}`}
              class="px-3.5 py-2.5 rounded-xl border border-border bg-card hover:border-primary/50 hover:text-primary transition-all text-xs font-semibold text-foreground text-center"
            >
              {fn.first} {fn.last}
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Ad Slot 2: Mid-content main break -->
    <div class="homepage-ad-break">
      <AdSlot format="responsive" />
    </div>

    <!-- Section 5: How Name Estimates Work (3 Simple Steps) -->
    <section class="homepage-section space-y-8">
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="font-display text-2xl md:text-3xl font-bold text-foreground mb-2">
          How Name Estimates Work
        </h2>
        <p class="text-sm text-muted-foreground">
          A transparent, evidence-based methodology in three steps
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl border border-border bg-card space-y-3">
          <div class="h-10 w-10 rounded-xl bg-primary/10 flex items-center justify-center text-primary font-bold text-base">
            1
          </div>
          <h3 class="font-bold text-lg text-foreground">Enter a Name</h3>
          <p class="text-xs md:text-sm text-muted-foreground leading-relaxed">
            Search your first name, surname, or full name combination. Supports international accents, hyphens, and apostrophes.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-border bg-card space-y-3">
          <div class="h-10 w-10 rounded-xl bg-primary/10 flex items-center justify-center text-primary font-bold text-base">
            2
          </div>
          <h3 class="font-bold text-lg text-foreground">We Query Official Data</h3>
          <p class="text-xs md:text-sm text-muted-foreground leading-relaxed">
            We cross-reference historical SSA birth cohorts ({manifest.sources.ssa.coverageYears}), U.S. Census records, and CDC survival tables.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-border bg-card space-y-3">
          <div class="h-10 w-10 rounded-xl bg-primary/10 flex items-center justify-center text-primary font-bold text-base">
            3
          </div>
          <h3 class="font-bold text-lg text-foreground">Get Clear Estimates</h3>
          <p class="text-xs md:text-sm text-muted-foreground leading-relaxed">
            Receive an instant demographic breakdown with clearly marked source-backed data or statistical estimates.
          </p>
        </div>
      </div>
    </section>

    <!-- Section 6: More Name Statistics Tools -->
    <section class="homepage-section space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-border/60 pb-6 md:pb-8">
        <div>
          <h2 class="font-display text-2xl md:text-3xl font-bold text-foreground">
            More Name Statistics Tools
          </h2>
          <p class="text-sm text-muted-foreground mt-1">
            Focused tools to analyze, compare, and explore demographic name data
          </p>
        </div>
        <a href="/tools" class="text-sm font-semibold text-primary hover:underline inline-flex items-center gap-1 shrink-0">
          View all tools →
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 md:gap-6">
        <!-- 1. Popularity Checker -->
        <a
          href="/tools/popularity-checker"
          class="p-6 rounded-2xl border border-border border-t-2 border-t-emerald-500/80 bg-card hover:border-emerald-500/40 hover:shadow-lg hover:-translate-y-1 transition-all group flex flex-col justify-between"
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <div class="h-10 w-10 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 flex items-center justify-center">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="20" x2="18" y2="10"></line>
                  <line x1="12" y1="20" x2="12" y2="4"></line>
                  <line x1="6" y1="20" x2="6" y2="14"></line>
                </svg>
              </div>
              <div class="flex items-end gap-1 h-5 px-2 py-0.5 rounded bg-emerald-500/5 border border-emerald-500/15" aria-hidden="true">
                <div class="w-1.5 h-2 bg-emerald-500/40 rounded-xs"></div>
                <div class="w-1.5 h-3.5 bg-emerald-500/60 rounded-xs"></div>
                <div class="w-1.5 h-2.5 bg-emerald-500/50 rounded-xs"></div>
                <div class="w-1.5 h-4.5 bg-emerald-500 rounded-xs"></div>
              </div>
            </div>
            <div>
              <h3 class="font-bold text-base text-foreground group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                Popularity Checker
              </h3>
              <p class="text-xs text-muted-foreground leading-relaxed mt-1.5">
                Check national rank and living bearer counts for any first name.
              </p>
            </div>
          </div>
          <div class="pt-4 mt-2 border-t border-border/50 flex items-center text-xs font-semibold text-emerald-600 dark:text-emerald-400">
            <span>Explore popularity</span>
            <span class="ml-1 transition-transform group-hover:translate-x-0.5">→</span>
          </div>
        </a>

        <!-- 2. Name Comparison -->
        <a
          href="/tools/name-comparison"
          class="p-6 rounded-2xl border border-border border-t-2 border-t-blue-500/80 bg-card hover:border-blue-500/40 hover:shadow-lg hover:-translate-y-1 transition-all group flex flex-col justify-between"
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <div class="h-10 w-10 rounded-xl bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20 flex items-center justify-center">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 3h5v5"></path>
                  <path d="M8 3H3v5"></path>
                  <path d="M12 22v-8.3"></path>
                  <path d="m21 3-7.5 7.5"></path>
                  <path d="m3 3 7.5 7.5"></path>
                </svg>
              </div>
              <div class="flex items-center gap-1.5 h-5 px-2 py-0.5 rounded bg-blue-500/5 border border-blue-500/15" aria-hidden="true">
                <div class="w-2.5 h-2 bg-blue-500 rounded-xs"></div>
                <span class="text-[9px] font-bold text-blue-600 dark:text-blue-400 font-mono">VS</span>
                <div class="w-3.5 h-2 bg-indigo-500/60 rounded-xs"></div>
              </div>
            </div>
            <div>
              <h3 class="font-bold text-base text-foreground group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                Name Comparison
              </h3>
              <p class="text-xs text-muted-foreground leading-relaxed mt-1.5">
                Compare two names side-by-side on popularity, rank, and historical trends.
              </p>
            </div>
          </div>
          <div class="pt-4 mt-2 border-t border-border/50 flex items-center text-xs font-semibold text-blue-600 dark:text-blue-400">
            <span>Compare names</span>
            <span class="ml-1 transition-transform group-hover:translate-x-0.5">→</span>
          </div>
        </a>

        <!-- 3. Trend Visualizer -->
        <a
          href="/tools/trend-visualizer"
          class="p-6 rounded-2xl border border-border border-t-2 border-t-purple-500/80 bg-card hover:border-purple-500/40 hover:shadow-lg hover:-translate-y-1 transition-all group flex flex-col justify-between"
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <div class="h-10 w-10 rounded-xl bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20 flex items-center justify-center">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m3 3 3 9 4-6 5 10 6-5"></path>
                </svg>
              </div>
              <div class="flex items-center h-5 px-2 py-0.5 rounded bg-purple-500/5 border border-purple-500/15" aria-hidden="true">
                <svg class="w-7 h-3 text-purple-500" viewBox="0 0 28 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M1 9 L7 10 L14 3 L21 6 L27 1"></path>
                </svg>
              </div>
            </div>
            <div>
              <h3 class="font-bold text-base text-foreground group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
                Trend Visualizer
              </h3>
              <p class="text-xs text-muted-foreground leading-relaxed mt-1.5">
                Explore 140+ years of historical baby name trajectories since 1880.
              </p>
            </div>
          </div>
          <div class="pt-4 mt-2 border-t border-border/50 flex items-center text-xs font-semibold text-purple-600 dark:text-purple-400">
            <span>View historical curves</span>
            <span class="ml-1 transition-transform group-hover:translate-x-0.5">→</span>
          </div>
        </a>

        <!-- 4. Random Name Explorer -->
        <a
          href="/tools/random-name"
          class="p-6 rounded-2xl border border-border border-t-2 border-t-amber-500/80 bg-card hover:border-amber-500/40 hover:shadow-lg hover:-translate-y-1 transition-all group flex flex-col justify-between"
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <div class="h-10 w-10 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 flex items-center justify-center">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
                  <circle cx="8.5" cy="8.5" r="1.5"></circle>
                  <circle cx="15.5" cy="8.5" r="1.5"></circle>
                  <circle cx="12" cy="12" r="1.5"></circle>
                  <circle cx="8.5" cy="15.5" r="1.5"></circle>
                  <circle cx="15.5" cy="15.5" r="1.5"></circle>
                </svg>
              </div>
              <div class="flex items-center gap-1 h-5 px-2 py-0.5 rounded bg-amber-500/5 border border-amber-500/15" aria-hidden="true">
                <div class="w-1.5 h-1.5 rounded-full bg-amber-500"></div>
                <div class="w-1.5 h-1.5 rounded-full bg-amber-500/50"></div>
                <div class="w-1.5 h-1.5 rounded-full bg-amber-500/80"></div>
              </div>
            </div>
            <div>
              <h3 class="font-bold text-base text-foreground group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">
                Random Name Explorer
              </h3>
              <p class="text-xs text-muted-foreground leading-relaxed mt-1.5">
                Discover real recorded names across historical popularity tiers.
              </p>
            </div>
          </div>
          <div class="pt-4 mt-2 border-t border-border/50 flex items-center text-xs font-semibold text-amber-600 dark:text-amber-400">
            <span>Discover names</span>
            <span class="ml-1 transition-transform group-hover:translate-x-0.5">→</span>
          </div>
        </a>
      </div>
    </section>

    <!-- Ad Slot 3: Lower content break -->
    <div class="homepage-ad-break">
      <AdSlot format="responsive" />
    </div>

    <!-- Section 7: Data Sources & Why Results Can Differ (AEO-Friendly) -->
    <section class="homepage-section border-t border-border/60 pt-12 md:pt-16">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        <!-- Card 1: Where the Data Comes From -->
        <div class="p-6 md:p-8 rounded-2xl border border-border bg-card shadow-xs space-y-6 flex flex-col justify-between">
          <div class="space-y-4">
            <div class="flex items-center gap-3">
              <div class="h-9 w-9 rounded-xl bg-primary/10 text-primary border border-primary/20 flex items-center justify-center shrink-0">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                  <path d="M3 5V19A9 3 0 0 0 21 19V5"></path>
                  <path d="M3 12A9 3 0 0 0 21 12"></path>
                </svg>
              </div>
              <h2 class="font-display text-xl md:text-2xl font-bold text-foreground">
                Where the Data Comes From
              </h2>
            </div>
            <p class="text-xs md:text-sm text-muted-foreground leading-relaxed">
              HowManyOfMe uses official U.S. government public domain datasets:
            </p>

            <div class="space-y-4 pt-1">
              <!-- Item 1: SSA -->
              <div class="flex items-start gap-3">
                <div class="h-6 w-6 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <div class="space-y-1 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <strong class="text-xs sm:text-sm text-foreground">Social Security Administration</strong>
                    <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/20">
                      1880 → {manifest.sources.ssa.latestAvailableYear}
                    </span>
                  </div>
                  <p class="text-xs text-muted-foreground leading-relaxed">
                    Historical birth cohorts from 1880 through {manifest.sources.ssa.latestAvailableYear} covering millions of annual card registrations.
                  </p>
                </div>
              </div>

              <!-- Item 2: Census -->
              <div class="flex items-start gap-3">
                <div class="h-6 w-6 rounded-lg bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                  </svg>
                </div>
                <div class="space-y-1 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <strong class="text-xs sm:text-sm text-foreground">U.S. Census Bureau</strong>
                    <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-700 dark:text-blue-300 border border-blue-500/20">
                      Decennial Tabulation
                    </span>
                  </div>
                  <p class="text-xs text-muted-foreground leading-relaxed">
                    2020 Decennial Census first-names tabulations and Decennial surname frequencies.
                  </p>
                </div>
              </div>

              <!-- Item 3: Actuarial -->
              <div class="flex items-start gap-3">
                <div class="h-6 w-6 rounded-lg bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  </svg>
                </div>
                <div class="space-y-1 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <strong class="text-xs sm:text-sm text-foreground">Actuarial Survival Tables</strong>
                    <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-purple-500/10 text-purple-700 dark:text-purple-300 border border-purple-500/20">
                      CDC &amp; SSA Curves
                    </span>
                  </div>
                  <p class="text-xs text-muted-foreground leading-relaxed">
                    CDC &amp; SSA cohort life tables for estimating living population across all generations.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div class="pt-4 border-t border-border/50">
            <a href="/methodology" class="text-xs font-semibold text-primary hover:underline inline-flex items-center gap-1">
              <span>Read full data methodology &amp; transparency notes</span>
              <span>→</span>
            </a>
          </div>
        </div>

        <!-- Card 2: Why Results Can Differ -->
        <div class="p-6 md:p-8 rounded-2xl border border-border bg-card shadow-xs space-y-6 flex flex-col justify-between">
          <div class="space-y-4">
            <div class="flex items-center gap-3">
              <div class="h-9 w-9 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 flex items-center justify-center shrink-0">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                  <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
              </div>
              <h2 class="font-display text-xl md:text-2xl font-bold text-foreground">
                Why Results Can Differ
              </h2>
            </div>
            <p class="text-xs md:text-sm text-muted-foreground leading-relaxed">
              If you see different numbers on other name tools, here is why:
            </p>

            <div class="space-y-4 pt-1">
              <!-- Item 1: Births vs Living -->
              <div class="flex items-start gap-3">
                <div class="h-6 w-6 rounded-lg bg-secondary text-muted-foreground flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m18 8 4 4-4 4"></path>
                    <path d="M2 12h20"></path>
                    <path d="m6 16-4-4 4-4"></path>
                  </svg>
                </div>
                <div class="space-y-1 flex-1">
                  <strong class="text-xs sm:text-sm text-foreground block">Births vs. Living People</strong>
                  <p class="text-xs text-muted-foreground leading-relaxed">
                    Many sites only display total cumulative births without accounting for natural mortality over time.
                  </p>
                </div>
              </div>

              <!-- Item 2: Single-Year vs Cohort -->
              <div class="flex items-start gap-3">
                <div class="h-6 w-6 rounded-lg bg-secondary text-muted-foreground flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="20" x2="12" y2="10"></line>
                    <line x1="18" y1="20" x2="18" y2="4"></line>
                    <line x1="6" y1="20" x2="6" y2="16"></line>
                  </svg>
                </div>
                <div class="space-y-1 flex-1">
                  <strong class="text-xs sm:text-sm text-foreground block">Single-Year vs. Cohort Models</strong>
                  <p class="text-xs text-muted-foreground leading-relaxed">
                    Some tools only show recent annual baby name counts rather than the entire living age pyramid.
                  </p>
                </div>
              </div>

              <!-- Item 3: Observed vs Modelled -->
              <div class="flex items-start gap-3">
                <div class="h-6 w-6 rounded-lg bg-secondary text-muted-foreground flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    <path d="m9 12 2 2 4-4"></path>
                  </svg>
                </div>
                <div class="space-y-1 flex-1">
                  <strong class="text-xs sm:text-sm text-foreground block">Observed vs. Modelled Data</strong>
                  <p class="text-xs text-muted-foreground leading-relaxed">
                    We clearly label when a name uses direct official records versus derived statistical estimates.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 8: FAQ Accordion -->
    <section class="homepage-section space-y-8" id="faq">
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="font-display text-2xl md:text-3xl font-bold text-foreground mb-2">
          Frequently Asked Questions
        </h2>
        <p class="text-sm text-muted-foreground">
          Common questions about name demographics, estimates, and data accuracy
        </p>
      </div>

      <div class="max-w-3xl mx-auto space-y-3">
        {faqs.map((item) => (
          <details class="group p-4 md:p-5 rounded-xl border border-border bg-card open:bg-card/90 transition-colors">
            <summary class="font-semibold text-sm md:text-base text-foreground cursor-pointer list-none flex items-center justify-between gap-3">
              <span>{item.q}</span>
              <span class="text-primary text-lg transition-transform group-open:rotate-45 shrink-0">+</span>
            </summary>
            <p class="mt-3 text-xs md:text-sm text-muted-foreground leading-relaxed border-t border-border/50 pt-3">
              {item.a}
            </p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
