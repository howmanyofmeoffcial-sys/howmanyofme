---
import { ALPHABET } from '../data/nameData';
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-border bg-secondary/30 mt-20">
  <div class="container py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div>
        <h3 class="font-display text-lg font-bold mb-3 text-foreground">HowManyOfMe</h3>
        <p class="text-sm text-muted-foreground leading-relaxed">
          Check how common your first name, last name, or full name is in the United States using official government records and demographic models.
        </p>
      </div>
      <div>
        <h4 class="font-semibold mb-3 text-sm text-foreground">Browse by Letter</h4>
        <div class="flex flex-wrap gap-1.5">
          {ALPHABET.map((l) => (
            <a
              href={`/names/${l}`}
              class="text-xs font-medium text-muted-foreground hover:text-primary transition-colors uppercase w-6 h-6 flex items-center justify-center rounded bg-secondary hover:bg-primary/10"
            >
              {l}
            </a>
          ))}
        </div>
      </div>
      <div>
        <h4 class="font-semibold mb-3 text-sm text-foreground">Directories &amp; Tools</h4>
        <ul class="space-y-1.5 text-sm text-muted-foreground list-none p-0 m-0">
          <li><a href="/names/a" class="hover:text-foreground transition-colors">First Names Directory</a></li>
          <li><a href="/last-names" class="hover:text-foreground transition-colors">Last Names Directory</a></li>
          <li><a href="/people/james-smith" class="hover:text-foreground transition-colors">Full Name Profiles</a></li>
          <li><a href="/tools/popularity-checker" class="hover:text-foreground transition-colors">Popularity Checker</a></li>
          <li><a href="/tools/name-comparison" class="hover:text-foreground transition-colors">Name Comparison</a></li>
          <li><a href="/tools/trend-visualizer" class="hover:text-foreground transition-colors">Trend Visualizer</a></li>
          <li><a href="/tools/random-name" class="hover:text-foreground transition-colors">Random Name Explorer</a></li>
          <li><a href="/tools" class="hover:text-foreground transition-colors">All Name Tools →</a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-semibold mb-3 text-sm text-foreground">Resources &amp; Data</h4>
        <ul class="space-y-1.5 text-sm text-muted-foreground list-none p-0 m-0">
          <li><a href="/about" class="hover:text-foreground transition-colors">About Us</a></li>
          <li><a href="/methodology" class="hover:text-foreground transition-colors">Data Methodology</a></li>
          <li><a href="/data" class="hover:text-foreground transition-colors">Data Sources &amp; Governance</a></li>
          <li><a href="/blog" class="hover:text-foreground transition-colors">Demographic Research</a></li>
          <li><a href="/privacy" class="hover:text-foreground transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-foreground transition-colors">Terms of Service</a></li>
          <li><a href="/contact" class="hover:text-foreground transition-colors">Contact</a></li>
        </ul>
      </div>
    </div>

    <!-- Author Section -->
    <div class="border-t border-border mt-8 pt-6">
      <div class="max-w-2xl mx-auto text-center">
        <p class="text-sm font-semibold text-foreground mb-2">Built by Ziven Borceg</p>
        <p class="text-sm text-muted-foreground leading-relaxed mb-3">
          HowManyOfMe is an independent demographic research platform providing transparent U.S. name statistics derived from historical Social Security Administration birth cohorts and Decennial Census distributions.
        </p>
        <a
          href="https://medium.com/@zivenborceg"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sm text-primary hover:text-primary/80 transition-colors font-medium"
        >
          Follow on Medium
          <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 3h6v6" /><path d="M10 14 21 3" /><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
          </svg>
        </a>
      </div>
    </div>

    <div class="border-t border-border mt-6 pt-6 text-center text-xs text-muted-foreground">
      © {currentYear} HowManyOfMe. All rights reserved. Data is estimated for informational purposes based on public domain demographic records.
    </div>
  </div>
</footer>
