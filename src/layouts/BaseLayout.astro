---
import SEO from '../components/SEO.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  author?: string;
  publishedTime?: string;
}

const props = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Preconnects & DNS Prefetches for Performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />

    <!-- Non-blocking Typography Loading (Inter + Playfair Display) -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Playfair+Display:wght@700;800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Playfair+Display:wght@700;800&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Playfair+Display:wght@700;800&display=swap"
      />
    </noscript>

    <!-- Server-Rendered Head SEO & Metadata -->
    <SEO {...props} />

    <!-- Mediavine / Grow Ads Initializers -->
    <script is:inline data-grow-initializer="">
      !(function(){window.growMe||((window.growMe=function(e){window.growMe._.push(e);}),(window.growMe._=[]));var e=document.createElement("script");(e.type="text/javascript"),(e.src="https://faves.grow.me/main.js"),(e.defer=!0),e.setAttribute("data-grow-faves-site-id","U2l0ZTo0OTgyZjJlMC1hMWEwLTQzODctODliZS04ZjdiZjA2ZWQ3Mzc=");var t=document.getElementsByTagName("script")[0];t.parentNode.insertBefore(e,t);})();
    </script>
    <script is:inline type="text/javascript" async data-noptimize="1" data-cfasync="false" src="//scripts.scriptwrapper.com/tags/4521ab76-baf8-4ec9-ae60-73e3b33b5a2b.js"></script>
  </head>

  <body class="min-h-screen bg-background text-foreground font-sans antialiased">
    <slot />

    <!-- Deferred Analytics & Tag Manager (Fires on Idle / First User Interaction) -->
    <script is:inline>
      (function () {
        function loadDeferred() {
          var gtm = document.createElement('script');
          gtm.async = true;
          gtm.src = 'https://www.googletagmanager.com/gtag/js?id=G-Q1NTDXVHWE';
          document.head.appendChild(gtm);
          window.dataLayer = window.dataLayer || [];
          function gtag(){window.dataLayer.push(arguments);}
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', 'G-Q1NTDXVHWE');
        }

        var fired = false;
        function go() { if (fired) return; fired = true; loadDeferred(); }
        if ('requestIdleCallback' in window) {
          requestIdleCallback(go, { timeout: 4000 });
        } else {
          setTimeout(go, 3500);
        }
        ['scroll', 'pointerdown', 'keydown', 'touchstart'].forEach(function (ev) {
          window.addEventListener(ev, go, { once: true, passive: true });
        });
      })();
    </script>
  </body>
</html>
